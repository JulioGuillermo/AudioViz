#version 450
// Fluid pass: draws the fluid / liquid transition (effects.FluidFrame) into the FluidImg buffer,
// one invocation per pixel, before render.comp reads it as background image 2.
// Same math as FluidFrame.pixel in internal/effects/fluid.go (CPU path).
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// the backgrounds' depth (camera.glsl), in the overlay buffer
layout(std430, set = 0, binding = 9) readonly buffer Layers { uint lay[]; };
#include "common.glsl"
#include "camera.glsl"

// Image img at background point u seen by its 2.5D camera (each image with its own: in a
// transition drawn once per image, B's effects are fxB), as render.comp shows it outside the
// fluid: the pieces carry the images as they were moving (as sampler.atCam)
vec3 camAt(int img, vec2 u) {
    if (P.depthI.z == 0 || (P.depthI.z & (1 << img)) == 0) return layerAt(img, u);
    int g = gFX;
    gFX = img == 1 && P.transP.y > 0.5 ? 1 : 0;
    if (fParN() > 0) u = parallaxFind(img, u).xy;
    gFX = g;
    return layerAt(img, u);
}

// Per particle 8 floats (x, y, p, -, old piece x, y, new piece x, y) sorted by bin, then the
// bin starts (uint) and the coarse level (floats), at the offsets in P.fluidI
layout(std430, set = 0, binding = 7) readonly buffer FluidData { uint fd[]; };
layout(std430, set = 0, binding = 7) readonly buffer FluidParts { vec4 fp[]; }; // the particles, 2 per particle
layout(std430, set = 0, binding = 8) writeonly buffer FluidImg { uint fimg[]; };

float fdf(int i) { return uintBitsToFloat(fd[i]); }

// Coarse level: channel ch at cell (x, y)
float coarse(int x, int y, int ch) { return fdf(P.fluidI.z + (y * P.fluidN.z + x) * 4 + ch); }

void main() {
    W = P.dims.x;
    H = P.dims.y;
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= W || px.y >= H) return;
    vec2 hb = P.fluidF.xy;
    float k = P.fluidF.z;
    int bin = P.fluidI.w, nbx = P.fluidN.x, nby = P.fluidN.y;
    vec2 f = vec2(px);
    vec3 acc = vec3(0.0);
    float w = 0.0;
    float pw = 0.0; // how much of the new image the pieces bring (for the depth: written in alpha)
    // The pieces covering the pixel, each weighted by how much of it it covers (antialiased squares)
    // Only the bins that can hold a piece touching the pixel (its center within half a piece)
    float bs = float(bin);
    int bx0 = max(0, int((f.x - hb.x) / bs)), bx1 = min(nbx - 1, int((f.x + 1.0 + hb.x) / bs));
    int by0 = max(0, int((f.y - hb.y) / bs)), by1 = min(nby - 1, int((f.y + 1.0 + hb.y) / bs));
    for (int yy = by0; yy <= by1; yy++) {
        for (int xx = bx0; xx <= bx1; xx++) {
            int b = yy * nbx + xx;
            int s1 = int(fd[P.fluidI.x + b + 1]);
            for (int j = int(fd[P.fluidI.x + b]); j < s1; j++) {
                vec4 q = fp[j * 2];
                vec2 cov = min(f + 1.0, q.xy + hb) - max(f, q.xy - hb);
                if (cov.x <= 0.0 || cov.y <= 0.0) continue;
                float wgt = cov.x * cov.y;
                // The piece it carries: the same offset inside its block, in each image
                vec4 src = fp[j * 2 + 1];
                vec2 off = f - q.xy;
                float p = q.z;
                vec3 c = vec3(0.0);
                if (p < 1.0) c = camAt(0, src.xy + off);
                if (p > 0.0) c = mix(c, camAt(1, src.zw + off), p);
                acc += c * wgt;
                pw += p * wgt;
                w += wgt;
            }
        }
    }
    vec3 c = w > 1e-4 ? acc / w : vec3(0.0);
    float nb = w > 1e-4 ? pw / w : k;
    if (w < 1.0) {
        nb = mix(k, nb, w);
        // Where the area is almost empty, a dim mix of both images, or the soft color of the
        // particles around (bilinear on the 1/8 coarse grid)
        vec3 g = mix(camAt(0, f), camAt(1, f), k) * 0.5;
        int cw = P.fluidN.z, ch = P.fluidN.w;
        vec2 q = (f + 0.5) / 8.0 - 0.5;
        int c0 = clamp(int(floor(q.x)), 0, cw - 1), r0 = clamp(int(floor(q.y)), 0, ch - 1);
        int c1 = min(c0 + 1, cw - 1), r1 = min(r0 + 1, ch - 1);
        vec2 t = clamp(q - vec2(c0, r0), 0.0, 1.0);
        vec4 cb = mix(mix(vec4(coarse(c0, r0, 0), coarse(c0, r0, 1), coarse(c0, r0, 2), coarse(c0, r0, 3)),
                          vec4(coarse(c1, r0, 0), coarse(c1, r0, 1), coarse(c1, r0, 2), coarse(c1, r0, 3)), t.x),
                      mix(vec4(coarse(c0, r1, 0), coarse(c0, r1, 1), coarse(c0, r1, 2), coarse(c0, r1, 3)),
                          vec4(coarse(c1, r1, 0), coarse(c1, r1, 1), coarse(c1, r1, 2), coarse(c1, r1, 3)), t.x), t.y);
        if (cb.w > 1e-3) g = mix(g, cb.rgb / cb.w / 255.0, smoothstep(0.0, 40.0, cb.w));
        c = mix(g, c, w);
    }
    if (P.fluidF.w > 0.0 && w < 0.5) c = vec3(1.0, 0.0, 1.0);
    if (k > 0.96) {
        c = mix(c, camAt(1, f), smoothstep(0.96, 1.0, k));
        nb = mix(nb, 1.0, smoothstep(0.96, 1.0, k));
    }
    // alpha: how much of the new image is here (render.comp transPick: the depth follows it)
    fimg[px.y * W + px.x] = packUnorm4x8(vec4(c, nb));
}
