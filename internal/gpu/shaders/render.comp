#version 450
// Full render of one frame on the GPU (a single dispatch; a fluid / liquid transition is drawn
// before it by fluid.comp and read here as background image 2):
//   background (two images with motion + transition, zoom + ripple + chromatic aberration +
//   glitch + color/vignette)
//   -> particles -> visualizer (circular / horizontal / vertical / wave) with glow
//   -> NV12 conversion (BT.709, limited range) ready for the H.264 encoder.
// Each invocation processes a 4x2 pixel block (1 Y word per row + 1 UV word).
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Output of the fluid pass (fluid.comp), image 2 for texel()
layout(std430, set = 0, binding = 8) readonly buffer FluidImg { uint fimg[]; };
// Images of the overlay clips (premultiplied RGBA8), at P.layers[i].info.x
layout(std430, set = 0, binding = 9) readonly buffer Layers { uint lay[]; };
// The emitters' accumulations (emit.comp): read here for their light fields
layout(std430, set = 0, binding = 10) readonly buffer EmitAcc { uint eacc[]; };
#define FLUID_IMG_READ
// the backgrounds seen by the 2.5D camera (layerAt in common.glsl; defined below)
// (worked out once per pixel by parallaxPixel: how far each background is moved here, and the
// scene's point seen here with its nearness, for the lights and the clips behind things)
#define BG_PARALLAX
vec2 gParA = vec2(0.0), gParB = vec2(0.0);
vec3 gHit = vec3(0.0);
#include "common.glsl"

// Per-tile (workgroup) lists: particles and words that may touch the tile
const int TILE_PARTS = 512;
const int TILE_TEXT = 48;
shared int sPart[TILE_PARTS];
shared int sPartN;
shared int sText[TILE_TEXT];
shared int sTextN;

layout(std430, set = 0, binding = 2) writeonly buffer OutY { uint outY[]; };
layout(std430, set = 0, binding = 3) writeonly buffer OutUV { uint outUV[]; };
layout(std430, set = 0, binding = 4) writeonly buffer OutRGBA { uint outRGBA[]; };
layout(std430, set = 0, binding = 5) readonly buffer TextAtlas { uint atlas[]; };

uint hashU(uint x) {
    x = x * 747796405u + 2891336453u;
    uint w = ((x >> ((x >> 28u) + 4u)) ^ x) * 277803737u;
    return (w >> 22u) ^ w;
}

float hash3(uint a, uint b, uint c) {
    return float(hashU(a + hashU(b + hashU(c)))) / 4294967296.0;
}

vec2 dirVec(int d) {
    if (d == 1) return vec2(1.0, 0.0);
    if (d == 2) return vec2(0.0, -1.0);
    if (d == 3) return vec2(0.0, 1.0);
    return vec2(-1.0, 0.0);
}

// Burn (internal/effects/burn.go): value noise and fbm in units of the frame height
float vnoise(vec2 p, uint seed) {
    vec2 i = floor(p), f = p - i;
    vec2 u = f * f * (3.0 - 2.0 * f);
    uint cx = uint(int(i.x) + 4096), cy = uint(int(i.y) + 4096);
    float a = hash3(cx, cy, seed), b = hash3(cx + 1u, cy, seed);
    float c = hash3(cx, cy + 1u, seed), d = hash3(cx + 1u, cy + 1u, seed);
    return a + (b - a) * u.x + (c - a) * u.y + (a - b - c + d) * u.x * u.y;
}

float fbm(vec2 p, uint seed) {
    float s = 0.0, amp = 0.5, tot = 0.0;
    for (int o = 0; o < 4; o++) {
        s += amp * vnoise(p, seed + uint(o) * 101u);
        tot += amp;
        p = p * 2.0 + vec2(17.3, 5.1);
        amp *= 0.5;
    }
    return s / tot;
}

vec3 burnPixel(vec2 q, float k, uint seed) {
    float Hf = float(H);
    float ke = k * k * (3.0 - 2.0 * k);
    vec2 u = q / Hf;
    float amp = 0.25 * P.burnP.y;
    float charW = 0.02 + 0.1 * P.burnP.x;
    float emberW = 0.004 + 0.012 * P.burnP.x;
    float d = 1e9;
    int n = int(P.burnP.w);
    for (int i = 0; i < n; i++) d = min(d, distance(u, P.burnPts[i].xy));
    d += amp * (fbm(u * 5.0, seed) - 0.5) * 2.0 + 0.012 * (vnoise(u * 90.0, seed + 5u) - 0.5);
    float r = ke * (P.burnP.z + 2.0 * amp + 2.0 * charW) - (amp + charW);
    float s = r - d; // > 0: burned
    vec3 a = layerAt(0, q), b = layerAt(1, q);
    float ch = smoothstep(-charW, 0.0, s);
    a = mix(a, a * vec3(0.55, 0.38, 0.22), ch * 0.8);
    a = mix(a, vec3(13.0, 8.0, 5.0) / 255.0, smoothstep(-charW * 0.35, 0.0, s) * 0.9);
    if (s > 0.0) b *= 1.0 - 0.45 * exp(-s / (charW * 0.4));
    vec3 c = mix(a, b, smoothstep(0.0, 1.5 / Hf, s));
    float brk = smoothstep(0.3, 0.7, vnoise(u * 25.0 + vec2(k * 6.0, -k * 4.0), seed + 11u));
    float e = (s + emberW * 1.2) / emberW;
    float em = exp(-e * e) * (0.35 + 0.9 * brk);
    float g = s / (emberW * 5.0);
    em += 0.22 * exp(-g * g) * (0.5 + 0.5 * brk);
    if (s < 0.0 && s > -charW * 0.6) {
        uint cell = uint(floor(q.x / (Hf / 360.0))), row = uint(floor(q.y / (Hf / 360.0)));
        if (hash3(cell, row, seed + uint(k * 24.0)) > 0.985) em += 0.8 * (1.0 + s / (charW * 0.6));
    }
    float hot = pow(min(em, 1.0), 3.0) * 0.6;
    return c + P.burnCol.rgb * em * 1.6 + vec3(hot, hot * 0.9, hot * 0.6);
}

// Modes in config.TransitionModes order: 0 cut (A only), 1 fade, 2 dissolve, 3 dip_black,
// 4 flash, 5 wipe, 6 slide, 7 push, 8 zoom_in, 9 zoom_out, 10 circle, 11 clock, 12 glitch, 13 pixelate, 14 burn,
// 15 fluid, 16 liquid (drawn by the fluid pass into image 2)
vec3 composite(vec2 q) {
    int mode = P.trans.x;
    if (mode == 0) return layerAt(0, q);
    float k = clamp(P.transP.x, 0.0, 1.0);
    float ke = k * k * (3.0 - 2.0 * k);
    vec2 S = vec2(float(W), float(H));
    vec2 c = S * 0.5;
    uint seed = uint(P.trans.w);
    if (mode == 2) { // dissolve
        float n = hash3(uint(floor(q.x * 0.5)), uint(floor(q.y * 0.5)), seed);
        return mix(layerAt(0, q), layerAt(1, q), smoothstep(n, n + 0.1, k * 1.1));
    }
    if (mode == 3 || mode == 4) { // dip to black / flash through white
        vec3 mid = mode == 3 ? vec3(0.0) : vec3(1.0);
        if (k < 0.5) return mix(layerAt(0, q), mid, smoothstep(0.0, 1.0, 2.0 * k));
        return mix(mid, layerAt(1, q), smoothstep(0.0, 1.0, 2.0 * k - 1.0));
    }
    if (mode == 5) { // wipe: 0 where the new image appears first
        int d = P.trans.y;
        float u = d == 1 ? q.x / S.x : d == 2 ? 1.0 - q.y / S.y : d == 3 ? q.y / S.y : 1.0 - q.x / S.x;
        const float f = 0.02;
        float e = ke * (1.0 + 2.0 * f) - f;
        return mix(layerAt(0, q), layerAt(1, q), 1.0 - smoothstep(e - f, e + f, u));
    }
    if (mode == 6 || mode == 7) { // slide (new over old) / push (new pushes old)
        vec2 dv = dirVec(P.trans.y);
        vec2 qb = q + dv * S * (1.0 - ke);
        if (qb.x >= 0.0 && qb.x < S.x && qb.y >= 0.0 && qb.y < S.y) return layerAt(1, qb);
        return mode == 7 ? layerAt(0, q - dv * S * ke) : layerAt(0, q);
    }
    if (mode == 8) { // zoom_in: fly into the old image while the new one settles
        float s = 1.0 + 1.5 * ke;
        float sb = 1.0 + 0.2 * (1.0 - ke);
        return mix(layerAt(0, c + (q - c) / s), layerAt(1, c + (q - c) / sb), smoothstep(0.3, 1.0, k));
    }
    if (mode == 9) { // zoom_out: the new image arrives from very close
        float s = 1.0 + 1.5 * (1.0 - ke);
        return mix(layerAt(0, q), layerAt(1, c + (q - c) / s), smoothstep(0.0, 0.7, k));
    }
    if (mode == 10) { // circle (iris opening from the center)
        float diag = length(S) * 0.5;
        float f = 0.01 * diag;
        float r = ke * (diag + f);
        return mix(layerAt(0, q), layerAt(1, q), 1.0 - smoothstep(r - f, r + f, length(q - c)));
    }
    if (mode == 11) { // clock (radial sweep from 12 o'clock)
        float ang = atan(q.x - c.x, -(q.y - c.y));
        if (ang < 0.0) ang += 6.28318530718;
        float e = ke * (6.28318530718 + 0.04);
        return mix(layerAt(0, q), layerAt(1, q), 1.0 - smoothstep(e - 0.04, e, ang));
    }
    if (mode == 12) { // glitch: bands switch to the new image with shifts and RGB split
        float g = sin(3.14159265 * k);
        uint band = uint(int(floor(q.y)) / max(1, H / 24));
        uint stp = uint(k * 16.0);
        int img = hash3(band, stp, seed) < k ? 1 : 0;
        float shift = (hash3(band, stp + 97u, seed) - 0.5) * S.x * 0.08 * g;
        float split = 8.0 * g * (S.y / 1080.0);
        float xs = q.x + shift;
        return vec3(layerAt(img, vec2(xs + split, q.y)).r, layerAt(img, vec2(xs, q.y)).g, layerAt(img, vec2(xs - split, q.y)).b);
    }
    if (mode == 14) return burnPixel(q, k, seed); // burn (paper)
    if ((mode == 15 || mode == 16) && P.fluidI.w > 0) return bilinearImg(2, q);
    if (mode == 13) { // pixelate: blocks grow, swap at the middle, shrink
        float bs = 1.0 + floor(sin(3.14159265 * k) * 48.0 * (S.y / 1080.0));
        vec2 qp = (floor(q / bs) + 0.5) * bs;
        return mix(layerAt(0, qp), layerAt(1, qp), smoothstep(0.4, 0.6, k));
    }
    return mix(layerAt(0, q), layerAt(1, q), k); // fade
}

// Warp map: ripple then centered zoom (each effect reads the previous one's output)
// (defined below, with the depth maps)
float layerDepth(int which, vec2 q);
int depthWhich();

// how much a background effect applies at this pixel's depth (P.ranges[i]: from, to, soft, on;
// as effects.RangeMask)
float rangeMask(int i) {
    vec4 r = P.ranges[i];
    if (r.w < 0.5 || P.depthI.z == 0) return 1.0;
    float e = max(r.z, 1e-4);
    return smoothstep(r.y - e, r.y + e, gHit.z) * (1.0 - smoothstep(r.x - e, r.x + e, gHit.z));
}
// depth of field: how blurred (px) a point at nearness z is (as effects.DoF.CoC)
float dofCoC(float z) {
    vec4 d = P.dof;
    float o = max(max(d.y - z, z - d.x), 0.0);
    return d.w * smoothstep(0.0, max(d.z, 1e-3), o);
}

// frame point q through the background's ripple (if asked), zoom and shake
vec2 warpPoint(vec2 q, bool ripple) {
    vec2 c = vec2(float(W), float(H)) * 0.5;
    float amp = P.zoomRipple.y;
    if (ripple && amp > 0.2) {
        float ph = q.y * P.zoomRipple.z + P.zoomRipple.w;
        q += vec2(sin(ph), cos(ph)) * amp;
        q = clamp(q, vec2(0.0), vec2(float(W - 1), float(H - 1)));
    }
    float zoom = P.zoomRipple.x;
    if (zoom > 1.001) {
        q = c + (q - c) / zoom;
    }
    return q - P.shake.xy;
}
// the background at q, blurred by the depth of field: a golden-angle spiral of samples, what is
// nearer only counting if it is blurred enough to reach (as effects.ApplyDoF)
vec3 warpedDof(vec2 q, bool ripple) {
    vec2 u = warpPoint(q, ripple);
    float zc = gHit.z;
    float cc = (P.dof.w >= 0.5 && P.depthI.z != 0) ? dofCoC(zc) : 0.0;
    int nt = cc >= 0.5 ? P.parallaxN.y : 0; // the taps (from the params: a loop kept as one)
    float zoom = P.zoomRipple.x > 1.001 ? P.zoomRipple.x : 1.0;
    int w = depthWhich();
    vec3 c = vec3(0.0), sum = vec3(0.0);
    float ws = 0.0;
    // k = -1: the point itself (all there is when it isn't blurred)
    for (int k = -1; k < nt; k++) {
        vec2 o = vec2(0.0);
        if (k >= 0) {
            float r = sqrt((float(k) + 0.5) / float(nt));
            float a = float(k) * 2.39996323;
            o = vec2(cos(a), sin(a)) * r * cc;
        }
        vec2 ou = o / zoom;
        vec3 ct = composite(u + ou);
        if (k < 0) {
            c = ct;
            continue;
        }
        float zt = layerDepth(w, gHit.xy + ou);
        float wt = zt <= zc + 0.01 ? 1.0 : clamp(dofCoC(zt) / max(length(o), 1e-3), 0.0, 1.0);
        sum += ct * wt;
        ws += wt;
    }
    return ws > 1e-4 ? sum / ws : c;
}

bool inside(vec2 q) {
    return q.x >= 0.0 && q.x < float(W) && q.y >= 0.0 && q.y < float(H);
}

vec3 background(vec2 q) {
    // Glitch: horizontal shift of bands (only on its depths, if so)
    vec2 q0 = q;
    for (int i = 0; i < P.flags.w; i++) {
        vec4 g = P.glitch[i];
        if (q.y >= g.x && q.y < g.y) {
            float nx = q.x - g.z;
            if (nx >= 0.0 && nx < float(W)) q.x = nx;
        }
    }
    float mg = rangeMask(3), mr = rangeMask(2), mc = rangeMask(1);
    bool gl = q.x != q0.x && mg < 0.999;
    bool rr = mr < 0.999 && P.zoomRipple.y > 0.2;

    // Chromatic aberration: its red and blue points
    float shift = P.chroma.x;
    bool ch = P.flags2.x != 0 && shift > 0.5;
    vec2 off = vec2(0.0);
    if (ch) {
        if (P.flags2.x == 2) {
            vec2 c = vec2(float(W), float(H)) * 0.5;
            off = (q - c) / length(c) * shift;
        } else {
            off = vec2(-round(shift), 0.0);
        }
    }
    vec2 qr = q + off, qb = q - off;
    bool inR = ch && inside(qr), inB = ch && inside(qb);

    // the points to look at: q, q0 (the glitch on its depths), qr, qb; each with its ripple and,
    // with the ripple on its depths, also without it. One loop: the whole background (and the
    // depth of field's samples) is written once in the shader
    vec2 pts[4];
    int np = 0;
    pts[np++] = q;
    int iG = gl ? np : -1;
    if (gl) pts[np++] = q0;
    int iR = inR ? np : -1;
    if (inR) pts[np++] = qr;
    int iB = inB ? np : -1;
    if (inB) pts[np++] = qb;
    vec3 cs[4];
    int ns = rr ? np * 2 : np;
    for (int i = 0; i < ns; i++) {
        int j = rr ? i / 2 : i;
        bool rip = !rr || (i & 1) == 0;
        vec3 c = warpedDof(pts[j], rip);
        cs[j] = (rr && (i & 1) == 1) ? mix(c, cs[j], mr) : c;
    }
    vec3 col = cs[0];
    if (iG >= 0) col = mix(cs[iG], col, mg);
    if (iR >= 0) col.r = mix(col.r, cs[iR].r, mc); // with the 2.5D camera: moved as the pixel itself
    if (iB >= 0) col.b = mix(col.b, cs[iB].b, mc);

    // Brightness / contrast (the flash only on its depths, if so) / vignette / opacity
    vec4 ca = P.colorAdj;
    vec3 cf = ca.x * (col - 0.5) + 0.5 + ca.y;
    float mf = rangeMask(0);
    if (mf < 0.999) cf = mix(col + (ca.y - P.fxFlash.y), cf, mf);
    col = cf;
    if (ca.w > 0.01) {
        vec2 c = vec2(float(W), float(H)) * 0.5;
        vec2 d = q - c;
        col *= max(0.0, 1.0 - dot(d, d) / dot(c, c) * ca.w);
    }
    col *= ca.z;
    return clamp(col, 0.0, 1.0);
}

vec3 gradientAt(float t) {
    if (P.flags2.y == 1) return P.solidColor.rgb;
    int n = P.flags2.z;
    if (n == 0) return vec3(0.0, 240.0 / 255.0, 1.0);
    if (n == 1 || t <= P.grad[0].w) return P.grad[0].rgb;
    if (t >= P.grad[n - 1].w) return P.grad[n - 1].rgb;
    for (int i = 0; i < n - 1; i++) {
        vec4 a = P.grad[i];
        vec4 b = P.grad[i + 1];
        if (t >= a.w && t <= b.w) {
            return mix(a.rgb, b.rgb, (t - a.w) / max(b.w - a.w, 1e-6));
        }
    }
    return P.grad[n - 1].rgb;
}

float solidAlpha() { return P.flags2.y == 1 ? P.solidColor.a : 1.0; }

vec3 over(vec3 dst, vec3 src, float a) { return mix(dst, src, clamp(a, 0.0, 1.0)); }

// Glow equivalent to 3 concentric passes with opacity (intensity/3)*0.4
float glowAlpha(float d) {
    float R = max(P.viz2.x, 1.0);
    float a = P.viz2.y / 3.0 * 0.4;
    float k = clamp(3.0 * (1.0 - d / (R * 0.5)), 0.0, 3.0);
    return 1.0 - pow(1.0 - a, k);
}

float sdSegment(vec2 p, vec2 a, vec2 b) {
    vec2 pa = p - a, ba = b - a;
    float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);
    return length(pa - ba * h);
}

float sdRoundBox(vec2 p, vec2 lo, vec2 hi, float r) {
    vec2 c = (lo + hi) * 0.5;
    vec2 b = (hi - lo) * 0.5;
    r = min(r, min(b.x, b.y));
    vec2 q = abs(p - c) - b + r;
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}

// Position in the gradient: by bar index, or along the bar (dist = distance
// travelled from the base, h = current height of that bar)
float gradT(int i, int N, float dist, float h) {
    if (P.gradInfo.x < 0.5) return float(i) / float(N);
    float L = P.gradInfo.y > 0.5 ? P.gradInfo.z : h;
    return clamp(dist / max(L, 1.0), 0.0, 1.0);
}

// Visualizer accumulators: glow (max) and core (max) with their color
float gA, cA;
vec3 gC, cC;

void addShape(float d, vec3 color, float alpha) {
    alpha *= P.bgMix.y;
    float cov = clamp(0.5 - d, 0.0, 1.0) * alpha;
    if (cov > cA) { cA = cov; cC = color; }
    if (P.flags3.y != 0) {
        float g = glowAlpha(d) * alpha;
        if (g > gA) { gA = g; gC = color; }
    }
}

void circularBars(vec2 p) {
    int N = P.flags.y;
    vec2 c = P.viz0.xy;
    float r0 = P.viz0.z;
    float w = P.viz1.x;
    float stepA = 3.14159265 / float(N);
    vec2 d = p - c;
    float ang = atan(d.y, d.x);
    const float HALF_PI = 1.5707963;
    const float TWO_PI = 6.2831853;

    for (int ch = 0; ch < 2; ch++) {
        // L channel: from the top turning left; R channel: to the right
        float t = ch == 0 ? (-HALF_PI - ang) : (ang + HALF_PI);
        t = mod(t + TWO_PI, TWO_PI);
        int base = int(floor(t / stepA - 0.5));
        for (int k = -2; k <= 2; k++) {
            int i = base + k;
            if (i < 0 || i >= N) continue;
            float h = ch == 0 ? P.bars[i].x : P.bars[i].y;
            float a = ch == 0 ? (-HALF_PI - (float(i) + 0.5) * stepA) : (-HALF_PI + (float(i) + 0.5) * stepA);
            vec2 dir = vec2(cos(a), sin(a));
            float dist = sdSegment(p, c + dir * r0, c + dir * (r0 + h)) - w * 0.5;
            float along = dot(p - c, dir) - r0;
            addShape(dist, gradientAt(gradT(i, N, along, h)), solidAlpha());
        }
    }
}

void horizontalBars(vec2 p) {
    int N = P.flags.y;
    float cx = P.viz0.x;
    float baseY = P.viz0.w;
    float bw = P.viz1.x;
    float span = P.viz1.y;
    float rr = P.viz1.z;
    for (int ch = 0; ch < 2; ch++) {
        float hg = P.viz3.z * 0.5; // half the center gap
        float rel = ch == 0 ? (cx - hg - p.x) : (p.x - cx - hg);
        int base = int(floor(rel / span));
        for (int k = -1; k <= 1; k++) {
            int i = base + k;
            if (i < 0 || i >= N) continue;
            float h = ch == 0 ? P.bars[i].x : P.bars[i].y;
            float x0 = ch == 0 ? cx - hg - (float(i) * span + bw) : cx + hg + float(i) * span;
            float r = min(rr, min(bw * 0.5, h * 0.5));
            addShape(sdRoundBox(p, vec2(x0, baseY - h), vec2(x0 + bw, baseY), r), gradientAt(gradT(i, N, baseY - p.y, h)), solidAlpha());
            if (P.flags3.x != 0) {
                float hm = h * 0.5;
                float rm = min(rr, min(bw * 0.5, hm * 0.5));
                addShape(sdRoundBox(p, vec2(x0, baseY), vec2(x0 + bw, baseY + hm), rm), gradientAt(gradT(i, N, (p.y - baseY) * 2.0, h)), solidAlpha() * 0.35);
            }
        }
    }
}

void verticalBars(vec2 p) {
    int N = P.flags.y;
    float startY = P.viz3.x;
    float barH = P.viz3.y;
    float span = P.viz1.y;
    float rr = P.viz1.z;
    int base = int(floor((p.y - startY) / span));
    for (int k = -1; k <= 1; k++) {
        int i = base + k;
        if (i < 0 || i >= N) continue;
        float y0 = startY + float(i) * span;
        float lenL = max(P.bars[i].x, 2.0);
        float lenR = max(P.bars[i].y, 2.0);
        addShape(sdRoundBox(p, vec2(0.0, y0), vec2(lenL, y0 + barH), min(rr, min(barH, lenL) * 0.5)), gradientAt(gradT(i, N, p.x, lenL)), solidAlpha());
        addShape(sdRoundBox(p, vec2(float(W) - lenR, y0), vec2(float(W), y0 + barH), min(rr, min(barH, lenR) * 0.5)), gradientAt(gradT(i, N, float(W) - p.x, lenR)), solidAlpha());
    }
}

vec2 wavePoint(int i, int ch) {
    float mag = ch == 0 ? P.bars[i].z : P.bars[i].w;
    float dir = ch == 0 ? -1.0 : 1.0;
    return vec2(float(i) * P.viz2.w, P.viz0.w + dir * mag * P.viz2.z * sin(float(i) * 0.4));
}

void waveLines(vec2 p) {
    int N = P.flags.y;
    float w = P.viz1.x;
    int base = int(floor(p.x / P.viz2.w));
    for (int ch = 0; ch < 2; ch++) {
        vec3 col = ch == 0 ? P.waveColL.rgb : P.waveColR.rgb;
        if (P.gradInfo.x > 0.5) col = gradientAt(clamp(abs(p.y - P.viz0.w) / max(P.viz2.z, 1.0), 0.0, 1.0));
        for (int k = -2; k <= 1; k++) {
            int i = base + k;
            if (i < 0 || i + 1 >= N) continue;
            addShape(sdSegment(p, wavePoint(i, ch), wavePoint(i + 1, ch)) - w * 0.5, col, 1.0);
        }
    }
}

// ------------------------------------------------------------------ lyrics (SDF)

float atlasByte(int x, int y) {
    int idx = y * P.textInfo.y + x;
    return float((atlas[idx >> 2] >> ((idx & 3) * 8)) & 0xFFu);
}

// Signed distance (atlas px, + outside) with bilinear interpolation
float sdfAt(vec2 a, vec4 rect) {
    a = clamp(a, rect.xy, rect.xy + rect.zw - 1.0);
    ivec2 i0 = ivec2(floor(a));
    vec2 f = a - vec2(i0);
    ivec2 i1 = min(i0 + 1, ivec2(rect.xy + rect.zw - 1.0));
    float v = mix(mix(atlasByte(i0.x, i0.y), atlasByte(i1.x, i0.y), f.x),
                  mix(atlasByte(i0.x, i1.y), atlasByte(i1.x, i1.y), f.x), f.y);
    return (128.0 - v) / 4.0;
}

vec3 textGradient(int s, float t) {
    int n = P.ts[s].gradN.x;
    if (n <= 0) return P.ts[s].color.rgb;
    if (n == 1 || t <= P.ts[s].grad[0].w) return P.ts[s].grad[0].rgb;
    if (t >= P.ts[s].grad[n - 1].w) return P.ts[s].grad[n - 1].rgb;
    for (int i = 0; i < n - 1; i++) {
        vec4 a = P.ts[s].grad[i], b = P.ts[s].grad[i + 1];
        if (t >= a.w && t <= b.w) return mix(a.rgb, b.rgb, (t - a.w) / max(b.w - a.w, 1e-6));
    }
    return P.ts[s].grad[n - 1].rgb;
}

// A mask in lay (m: offset in words, one byte per px, width, height) at a point in its px
// (bilinear, 0 outside): the overlay clips' masks and the texts' screen masks
float maskByte(ivec4 m, int x, int y) {
    if (x < 0 || y < 0 || x >= m.y || y >= m.z) return 0.0;
    int idx = y * m.y + x;
    return float((lay[m.x + (idx >> 2)] >> ((idx & 3) * 8)) & 255u) / 255.0;
}
float maskBilinear(ivec4 m, vec2 q) {
    q -= 0.5;
    ivec2 i0 = ivec2(floor(q));
    vec2 f = q - vec2(i0);
    return mix(mix(maskByte(m, i0.x, i0.y), maskByte(m, i0.x + 1, i0.y), f.x),
               mix(maskByte(m, i0.x, i0.y + 1), maskByte(m, i0.x + 1, i0.y + 1), f.x), f.y);
}

// Composites the texts over col at point p. ch = -1, 0, 1: channel pass for chromatic
// aberration (each item's point is shifted by ch times its style's chroma).
// Texts of one stage among the overlay clips (stage < 0: all)
vec3 drawText(vec3 col, vec2 p0, float ch, int stage) {
    int n = min(sTextN, TILE_TEXT);
    for (int ti = 0; ti < n; ti++) {
        int i = sText[ti];
        int s = int(P.tC[i].z);
        if (stage >= 0 && min(P.ts[s].gradN.y, P.layerN.x) != stage) continue;
        vec4 inf = P.ts[s].info;
        float ow = inf.x;
        float gr = max(inf.y, 0.5);
        vec2 p = p0 + vec2(ch * inf.w, 0.0);
        vec4 r = P.tA[i];
        vec4 b = P.tB[i];
        float sc = b.z;
        float rc = cos(P.tC[i].w), rs = sin(P.tC[i].w);
        mat2 unrot = mat2(rc, -rs, rs, rc);    // turns screen offsets back by the item's rotation
        vec2 local = unrot * (p - b.xy) / sc;  // atlas px relative to the word center
        vec2 hs = r.zw * 0.5;
        if (abs(local.x) > hs.x || abs(local.y) > hs.y) continue;
        vec2 a = r.xy + hs + local;
        float pad = P.tC[i].y;
        float alpha = b.w;
        ivec4 tm = P.ts[s].mask;
        if (tm.w != 0) {
            alpha *= maskBilinear(tm, p0 * vec2(tm.yz) / vec2(W, H));
            if (alpha <= 0.0) continue;
        }
        vec4 dp = P.ts[s].depth;
        if (dp.x > 0.5 && P.depthI.z != 0) {
            // hidden where the scene is nearer (this pixel's depth)
            alpha *= 1.0 - smoothstep(dp.y - dp.z, dp.y + dp.z + 1e-4, gHit.z);
            if (alpha <= 0.0) continue;
        }
        float bl = dp.w; // the depth of field's blur: a soft edge of the distance field

        // Shadow (blurred)
        vec4 sh = P.ts[s].shadow;
        if (sh.z > 0.0) {
            float ds = sdfAt(a - unrot * sh.xy / sc, r) * sc - ow;
            float blur = max(sh.w, 0.75);
            float sa = (1.0 - smoothstep(-blur, blur, ds)) * sh.z * alpha;
            col = mix(col, P.ts[s].shadowC.rgb, sa);
        }

        float d = sdfAt(a, r) * sc;           // distance in screen px
        // Glow
        if (inf.z > 0.0) {
            float g = exp(-max(d - ow, 0.0) / (gr * 0.45)) * inf.z * alpha;
            g *= 1.0 - smoothstep(0.55, 0.95, (d / sc) / max(pad, 1.0)); // reaches 0 before the edge of the area
            col = mix(col, P.ts[s].glowC.rgb, clamp(g, 0.0, 1.0) * 0.85);
        }
        // Outline
        if (ow > 0.0) {
            float co = bl > 0.5 ? 1.0 - smoothstep(-bl, bl, d - ow) : clamp(0.5 - (d - ow), 0.0, 1.0);
            col = mix(col, P.ts[s].outline.rgb, co * P.ts[s].outline.a * alpha);
        }
        // Fill: main color up to the karaoke progress, the rest in the "upcoming" color
        float fillX = r.x + pad + P.tC[i].x * (r.z - 2.0 * pad);
        float ty = clamp((a.y - r.y - pad) / max(r.w - 2.0 * pad, 1.0), 0.0, 1.0);
        vec3 main = textGradient(s, ty);
        float k = clamp(fillX - a.x + 0.5, 0.0, 1.0);
        vec3 fc = mix(P.ts[s].upcoming.rgb, main, k);
        float fa = mix(P.ts[s].upcoming.a, P.ts[s].color.a, k);
        float cf = bl > 0.5 ? 1.0 - smoothstep(-bl, bl, d) : clamp(0.5 - d, 0.0, 1.0);
        col = mix(col, fc, cf * fa * alpha);
    }
    return col;
}

// ---- Overlay clips (same math as internal/effects/layers.go)

vec4 layerTexel(int i, ivec2 c) {
    ivec4 inf = P.layers[i].info;
    if (c.x < 0 || c.y < 0 || c.x >= inf.y || c.y >= inf.z) return vec4(0.0);
    return unpackUnorm4x8(lay[inf.x + c.y * inf.y + c.x]);
}

vec4 layerBilinear(int i, vec2 u) {
    u -= 0.5;
    ivec2 i0 = ivec2(floor(u));
    vec2 f = u - vec2(i0);
    return mix(mix(layerTexel(i, i0), layerTexel(i, i0 + ivec2(1, 0)), f.x),
               mix(layerTexel(i, i0 + ivec2(0, 1)), layerTexel(i, i0 + ivec2(1, 1)), f.x), f.y);
}

// Screen point (pixel center) → position in the clip's image
vec2 layerUV(int i, vec2 s) {
    LayerP L = P.layers[i];
    vec2 d = s - L.xf.xy;
    float r = L.xf2.x;
    if (r != 0.0) {
        float cs = cos(-r), sn = sin(-r);
        d = vec2(d.x * cs - d.y * sn, d.x * sn + d.y * cs);
    }
    return d / L.xf.zw + vec2(L.info.yz) * 0.5;
}

vec4 layerSample(int i, vec2 q) {
    float b = P.layers[i].xf2.z;
    if (b <= 0.5) return layerBilinear(i, layerUV(i, q + 0.5));
    vec4 acc = vec4(0.0);
    float tw = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            float w = 1.0 / float(1 + x * x + y * y);
            acc += layerBilinear(i, layerUV(i, q + 0.5 + vec2(x, y) * b)) * w;
            tw += w;
        }
    }
    return acc / tw;
}

// The clip's mask at a position of its image (bilinear; see maskBilinear)
float maskAt(int i, vec2 u) {
    ivec4 m = P.layers[i].mask;
    return maskBilinear(m, u * vec2(m.yz) / vec2(P.layers[i].info.yz));
}

// The clip's background effects: glitch bands, ripple, zoom, shake
vec2 layerWarp(int i, vec2 q) {
    LayerP L = P.layers[i];
    int gm = (L.info.w >> 5) & 3;
    if (gm == 1) {
        for (int g = 0; g < P.flags.w; g++) {
            vec4 s = P.glitch[g];
            if (q.y >= s.x && q.y < s.y) { float nx = q.x - s.z; if (nx >= 0.0 && nx < float(W)) q.x = nx; }
        }
    } else if (gm == 2) {
        int ng = (L.info.w >> 8) & 15;
        for (int g = 0; g < ng; g++) {
            vec4 s = L.glitch[g];
            if (q.y >= s.x && q.y < s.y) { float nx = q.x - s.z; if (nx >= 0.0 && nx < float(W)) q.x = nx; }
        }
    }
    if (L.warp0.y > 0.2) {
        float ph = q.y * L.warp0.z + L.warp0.w;
        q += vec2(sin(ph), cos(ph)) * L.warp0.y;
        q = clamp(q, vec2(0.0), vec2(float(W - 1), float(H - 1)));
    }
    vec2 c = vec2(float(W), float(H)) * 0.5;
    if (L.warp0.x > 1.001) q = c + (q - c) / L.warp0.x;
    return q - L.warp1.xy;
}

vec3 hueRotate(vec3 c, float a) {
    float cs = cos(a), sn = sin(a);
    const float k = 1.0 / 3.0;
    float s3 = sqrt(k);
    float r0 = cs + (1.0 - cs) * k, r1 = k * (1.0 - cs) - s3 * sn, r2 = k * (1.0 - cs) + s3 * sn;
    return vec3(dot(c, vec3(r0, r1, r2)), dot(c, vec3(r2, r0, r1)), dot(c, vec3(r1, r2, r0)));
}

vec3 blendColor(int m, vec3 d, vec3 s) {
    if (m == 1) return min(d + s, 1.0);
    if (m == 2) return d * s;
    if (m == 3) return 1.0 - (1.0 - d) * (1.0 - s);
    if (m == 4) return mix(2.0 * d * s, 1.0 - 2.0 * (1.0 - d) * (1.0 - s), step(0.5, d));
    if (m == 5) return max(d, s);
    if (m == 6) return min(d, s);
    return s;
}

// The depth of the frame at q (0 far … 1 near): the backgrounds' depth maps (a byte per pixel in
// lay, 16 bits per pixel) through the background's ripple, zoom, shake, motion and transition (as effects.Scene)
float depthTexel(int off, ivec2 c) {
    c = clamp(c, ivec2(0), ivec2(W - 1, H - 1));
    int idx = c.y * W + c.x;
    return float((lay[off + (idx >> 1)] >> ((idx & 1) * 16)) & 65535u) / 65535.0;
}
float layerDepth(int which, vec2 q) {
    vec4 L = which == 0 ? P.layerA : P.layerB;
    int off = which == 0 ? P.depthI.x : P.depthI.y;
    vec2 c = vec2(float(W), float(H)) * 0.5;
    vec2 d = q - c;
    if (L.w != 0.0) {
        float cs = cos(-L.w), sn = sin(-L.w);
        d = vec2(d.x * cs - d.y * sn, d.x * sn + d.y * cs);
    }
    float sc = L.x > 0.0 ? L.x : 1.0;
    vec2 u = clamp(c + d / sc + L.yz, vec2(0.0), vec2(float(W - 1), float(H - 1)));
    ivec2 i0 = ivec2(floor(u));
    vec2 f = u - vec2(i0);
    float a = depthTexel(off, i0) + (depthTexel(off, i0 + ivec2(1, 0)) - depthTexel(off, i0)) * f.x;
    float b = depthTexel(off, i0 + ivec2(0, 1)) + (depthTexel(off, i0 + ivec2(1, 1)) - depthTexel(off, i0 + ivec2(0, 1))) * f.x;
    return a + (b - a) * f.y;
}
// frame point q through the background's ripple, zoom and shake
vec2 bgPoint(vec2 q) {
    vec2 c = vec2(float(W), float(H)) * 0.5;
    float amp = P.zoomRipple.y;
    if (amp > 0.2) {
        float ph = q.y * P.zoomRipple.z + P.zoomRipple.w;
        q += vec2(sin(ph), cos(ph)) * amp;
        q = clamp(q, vec2(0.0), vec2(float(W - 1), float(H - 1)));
    }
    float zoom = P.zoomRipple.x;
    if (zoom > 1.001) q = c + (q - c) / zoom;
    return q - P.shake.xy;
}
// which background's depth the scene has now (B from halfway through a transition)
int depthWhich() {
    int has = P.depthI.z;
    return (has & 2) != 0 && ((has & 1) == 0 || P.transP.x >= 0.5) ? 1 : 0;
}

// The 2.5D camera (as effects.Parallax): a point at nearness z seen at u is moved by
// (z - focus)·(shift + dolly·(u - c)); the point seen at u is found from the nearest depth to the
// farthest (the first where the scene is at least that near), refined between the last two tries
vec2 pDisp(float z, vec2 u) {
    vec2 c = vec2(float(W), float(H)) * 0.5;
    return (z - P.parallax.w) * (P.parallax.xy + P.parallax.z * (u - c));
}
vec3 parallaxFind(int which, vec2 u) {
    int n = P.parallaxN.x;
    float thick = 1.5 / float(n) + 0.02; // a hit deeper than this past its depth: a side, go on
    float pz = 0.0, pe = 0.0;
    for (int k = 0; k <= n; k++) {
        float z = 1.0 - float(k) / float(n);
        vec2 p = u - pDisp(z, u);
        float d = layerDepth(which, p);
        float e = d - z;
        if (e < 0.0) {
            pz = z;
            pe = e;
            continue;
        }
        if (k == 0) return vec3(p, d);
        float t = pe / (pe - e);
        float zr = pz + (z - pz) * t;
        vec2 r = u - pDisp(zr, u);
        float dr = layerDepth(which, r);
        if (dr - zr <= thick) return vec3(r, dr);
        pz = z;
        pe = -1e-4;
    }
    vec2 p = u - pDisp(0.0, u);
    return vec3(p, layerDepth(which, p));
}
// parallaxPixel: the camera at frame pixel q, once: each background's move and the scene's hit
void parallaxPixel(vec2 q) {
    gParA = vec2(0.0);
    gParB = vec2(0.0);
    gHit = vec3(q, 0.0);
    int has = P.depthI.z;
    if (has == 0) return;
    vec2 u = bgPoint(q);
    int w = depthWhich();
    if (P.parallaxN.x == 0) {
        gHit = vec3(u, layerDepth(w, u));
        return;
    }
    for (int img = 0; img < 2; img++) {
        if ((has & (1 << img)) == 0) continue;
        vec3 r = parallaxFind(img, u);
        if (img == 0) gParA = u - r.xy;
        else gParB = u - r.xy;
        if (img == w) gHit = r;
    }
}

// the background point seen at this pixel (through the camera) and its nearness (as Scene.Hit)
vec3 sceneHit(vec2 q) { return gHit; }
float sceneDepth(vec2 q) { return gHit.z; }

// How much of a 2.5D light reaches q (as effects.LightField.DepthFactor): less with the difference
// of depth, more on the side of the surfaces that faces it (the surroundings looked at around the
// background point seen there), only between "to" and "from" (soft edges), and farther than the
// rim circle only the edges that face it. L2: where x, y, its depth, fade by depth; L3: shading,
// -, lit from, to; soft: the range's edge; L4: rim from, soft, width, gain (0 = off); edge: the rim's
float depthLight(vec2 q, vec4 L2, vec4 L3, float soft, vec4 L4, float edge) {
    vec3 h = sceneHit(q);
    int w = depthWhich();
    float zp = h.z;
    float dz = (zp - L2.z) * L2.w;
    float e = max(soft, 1e-4);
    float range = smoothstep(L3.w - e, L3.w + e, zp) * (1.0 - smoothstep(L3.z - e, L3.z + e, zp));
    float f = exp(-dz * dz) * range;
    float shade = L3.x;
    if (shade > 0.0) {
        float gx = (layerDepth(w, h.xy + vec2(2.0, 0.0)) - layerDepth(w, h.xy - vec2(2.0, 0.0))) / 4.0 * 800.0;
        float gy = (layerDepth(w, h.xy + vec2(0.0, 2.0)) - layerDepth(w, h.xy - vec2(0.0, 2.0))) / 4.0 * 800.0;
        vec3 n = vec3(-gx, -gy, 1.0);
        vec3 l = vec3(L2.x - q.x, L2.y - q.y, (L2.z - zp) * 800.0);
        float lam = max(0.0, dot(n, l) / (length(n) * (length(l) + 1e-3)));
        f *= 1.0 - shade + shade * (0.3 + 1.1 * lam);
    }
    if (L4.w > 0.0) {
        vec2 dl = L2.xy - q;
        float d = length(dl);
        float t = smoothstep(L4.x - L4.y, L4.x + L4.y + 1e-3, d);
        if (t > 0.0) {
            vec2 u = dl / max(d, 1e-3);
            float r = 0.0;
            for (int k = 1; k <= 4; k++) {
                float dz2 = zp - layerDepth(w, h.xy + u * (L4.z * float(k) / 4.0));
                r = max(r, smoothstep(edge * 0.35, edge, dz2) * (1.0 - 0.55 * float(k - 1) / 3.0));
            }
            f = mix(f, L4.w * r * range, t);
        }
    }
    return f;
}
float lightDepth(int i, vec2 q) {
    LayerP L = P.layers[i];
    return depthLight(q, L.light2, L.light3, L.light1.w, L.light4, L.light5.x);
}

// An emitter's light on col (what is behind it) at pixel q: its light field (bilinear between the
// 32 px cells), soft (lights and tints what is there) or add (as effects.LightField.Lit)
vec3 applyLight(vec3 col, int i, vec2 q) {
    LayerP L = P.layers[i];
    ivec4 l0 = L.light0;
    vec2 g = (q - L.warp1.xy + 0.5) / 32.0 - 0.5; // moved with its particles
    ivec2 i0 = ivec2(floor(g));
    vec2 f = g - vec2(i0);
    float v[4];
    for (int k = 0; k < 4; k++) {
        ivec2 c = clamp(i0 + ivec2(k & 1, k >> 1), ivec2(0), ivec2(l0.y - 1, l0.z - 1));
        v[k] = uintBitsToFloat(eacc[uint(l0.x) + uint(c.y * l0.y + c.x)]);
    }
    float a = v[0] + (v[1] - v[0]) * f.x, b = v[2] + (v[3] - v[2]) * f.x;
    float lt = a + (b - a) * f.y;
    if (lt > 1e-4 && L.light3.y > 0.5 && P.depthI.z != 0) lt *= lightDepth(i, q);
    if (lt <= 1e-4) return col;
    vec3 lc = L.light1.rgb * lt;
    if (l0.w == 2) col += lc * 0.6;
    else col += lc * (sqrt(max(col, vec3(0.0))) * 0.9 + 0.03);
    return min(col, vec3(1.0));
}

vec3 drawLayer(vec3 col, int i, vec2 q) {
    LayerP L = P.layers[i];
    if (L.light0.w != 0) col = applyLight(col, i, q);
    vec2 qw = layerWarp(i, q);
    vec4 s = layerSample(i, qw);
    if (L.mask.w != 0) s *= maskAt(i, layerUV(i, qw + 0.5));
    float shift = L.warp1.z;
    int cm = int(L.warp1.w);
    if (cm != 0 && shift > 0.5) {
        vec2 off;
        if (cm == 2) {
            vec2 c = vec2(float(W), float(H)) * 0.5;
            off = (q - c) / length(c) * shift;
        } else {
            off = vec2(-round(shift), 0.0);
        }
        if (inside(q + off)) s.r = layerSample(i, layerWarp(i, q + off)).r;
        if (inside(q - off)) s.b = layerSample(i, layerWarp(i, q - off)).b;
    }
    if (s.a <= 1e-4) return col;
    vec3 c = s.rgb / s.a;
    float key = 1.0;
    if ((L.info.w & 16) != 0) key = smoothstep(L.key.w, L.key.w + L.key2.x + 1e-4, distance(c, L.key.rgb));
    c = (c - 0.5) * (1.0 + L.adj.y) + 0.5 + L.adj.x;
    if (L.adj.z != 0.0) {
        float g = dot(c, vec3(0.2126, 0.7152, 0.0722));
        c = g + (c - g) * (1.0 + L.adj.z);
    }
    if (L.xf2.w != 0.0) c = hueRotate(c, L.xf2.w);
    c = L.warp2.x * (c - 0.5) + 0.5 + L.warp2.y;
    float a = clamp(s.a * key * L.xf2.y, 0.0, 1.0);
    // behind what is nearer than it
    if (L.depth.x > 0.5 && P.depthI.z != 0) a *= 1.0 - smoothstep(L.depth.y - L.depth.z, L.depth.y + L.depth.z + 1e-4, sceneDepth(q));
    return mix(col, blendColor(L.info.w & 15, col, clamp(c, 0.0, 1.0)), a);
}

// Fixed elements of the frame

vec3 drawParticles(vec3 col, vec2 p) {
    int np = min(sPartN, TILE_PARTS);
    for (int pi = 0; pi < np; pi++) {
        int i = sPart[pi];
        vec4 pt = P.parts[i];
        vec3 pc = P.partCol[i].rgb;
        float dist = length(p - pt.xy);
        if (P.partCol[i].w > 0.5) {
            float rg = pt.z * 2.0;
            if (dist < rg + 1.0) col = over(col, pc, clamp(rg - dist + 0.5, 0.0, 1.0) * pt.w * 0.3);
        }
        if (dist < pt.z + 1.0) col = over(col, pc, clamp(pt.z - dist + 0.5, 0.0, 1.0) * pt.w);
    }
    return col;
}

vec3 drawViz(vec3 col, vec2 p) {
    int vt = P.flags.x;
    if (vt == 0) return col;
    gA = 0.0; cA = 0.0; gC = vec3(0.0); cC = vec3(0.0);
    if (vt == 1) {
        if (P.flags3.w != 0) {
            // Base ring of the circular visualizer
            float rd = abs(length(p - P.viz0.xy) - (P.viz0.z - 2.0)) - 1.0;
            col = over(col, gradientAt(0.5), clamp(0.5 - rd, 0.0, 1.0) * P.viz1.w * P.bgMix.y);
        }
        circularBars(p);
    } else if (vt == 2) {
        horizontalBars(p);
    } else if (vt == 3) {
        verticalBars(p);
    } else if (vt == 4) {
        waveLines(p);
    }
    col = over(col, gC, gA);
    return over(col, cC, cA);
}

vec3 drawTexts(vec3 col, vec2 p, int stage) {
    if (P.textInfo.x <= 0) return col;
    if (P.textInfo.z != 0) {
        // Text chromatic aberration: each channel composited with an offset
        vec3 base = col;
        return vec3(drawText(base, p, -1.0, stage).r, drawText(base, p, 0.0, stage).g, drawText(base, p, 1.0, stage).b);
    }
    return drawText(col, p, 0.0, stage);
}

// A text's light on what is drawn so far at q (as effects.LightOnto): its grid of cells,
// bilinear; in 2.5D (with depth) as lightDepth, from the text's place and depth (lit range: all)
vec3 applyTextLight(vec3 col, int i, vec2 q) {
    ivec4 li = P.tlightI[i];
    vec2 g = (q + 0.5) / float(li.z) - 0.5;
    ivec2 i0 = ivec2(floor(g));
    vec2 f = g - vec2(i0);
    float v[4];
    for (int k = 0; k < 4; k++) {
        ivec2 c = clamp(i0 + ivec2(k & 1, k >> 1), ivec2(0), ivec2(li.x - 1, li.y - 1));
        int idx = c.y * li.x + c.x;
        v[k] = P.tlightV[i * TLIGHT_VEC4 + idx / 4][idx % 4];
    }
    float a = v[0] + (v[1] - v[0]) * f.x, b = v[2] + (v[3] - v[2]) * f.x;
    float lt = a + (b - a) * f.y;
    if (lt > 1e-4 && P.tlightE[i].y > 0.5 && P.depthI.z != 0)
        lt *= depthLight(q, P.tlightD[i], P.tlightE[i], P.tlightG[i].y, P.tlightF[i], P.tlightG[i].x);
    if (lt <= 1e-4) return col;
    vec3 lc = P.tlightC[i].rgb * lt;
    if (P.tlightC[i].w > 0.5) col += lc * 0.6;
    else col += lc * (sqrt(max(col, vec3(0.0))) * 0.9 + 0.03);
    return min(col, vec3(1.0));
}

// The frame at q: background, then each overlay clip; the particles, the visualizer and the
// texts at their stage among them (z-index)
vec3 shade(vec2 q) {
    vec2 p = q + 0.5;
    parallaxPixel(q);
    vec3 col = background(q);
    int nl = P.layerN.x;
    int zp = min(P.zIdx.x, nl), zv = min(P.zIdx.y, nl);
    int tmask = P.zIdx.z;
    for (int st = 0; st <= nl; st++) {
        if (st > 0) col = drawLayer(col, st - 1, q);
        if (zp == st) col = drawParticles(col, p);
        if (zv == st) col = drawViz(col, p);
        // texts of this stage (those set beyond the clips drawn go with the last stage)
        bool txt = ((tmask >> st) & 1) != 0 || (st == nl && (tmask >> (nl + 1)) != 0);
        if (txt) {
            // the texts of this stage that light the scene, then the texts
            for (int l = 0; l < MAX_TLIGHTS; l++) {
                ivec4 li = P.tlightI[l];
                if (li.x > 0 && min(P.ts[li.w].gradN.y, P.layerN.x) == st) col = applyTextLight(col, l, q);
            }
            col = drawTexts(col, p, st);
        }
    }
    return col;
}

uint packBytes(float a, float b, float c, float d) {
    uvec4 v = uvec4(clamp(round(vec4(a, b, c, d)), 0.0, 255.0));
    return v.x | (v.y << 8) | (v.z << 16) | (v.w << 24);
}

float lumaOf(vec3 c) { return 16.0 + 219.0 * dot(c, vec3(0.2126, 0.7152, 0.0722)); }

// Builds the lists of particles and words touching the tile [lo, hi) (full-resolution coords)
void buildTileLists(vec2 lo, vec2 hi) {
    uint li = gl_LocalInvocationIndex;
    if (li == 0u) { sPartN = 0; sTextN = 0; }
    barrier();
    int np = P.flags.z;
    for (int i = int(li); i < np; i += 64) {
        vec4 pt = P.parts[i];
        float rr = (P.partCol[i].w > 0.5 ? pt.z * 2.0 : pt.z) + 2.0;
        if (pt.x + rr >= lo.x && pt.x - rr <= hi.x && pt.y + rr >= lo.y && pt.y - rr <= hi.y) {
            int k = atomicAdd(sPartN, 1);
            if (k < TILE_PARTS) sPart[k] = i;
        }
    }
    int nt = P.textInfo.x;
    for (int i = int(li); i < nt; i += 64) {
        int s = int(P.tC[i].z);
        float extra = abs(P.ts[s].info.w) + max(abs(P.ts[s].shadow.x), abs(P.ts[s].shadow.y)) + P.ts[s].depth.w + 2.0;
        vec2 hw = P.tA[i].zw * 0.5 * P.tB[i].z;
        float rc = abs(cos(P.tC[i].w)), rs = abs(sin(P.tC[i].w));
        vec2 hs = vec2(hw.x * rc + hw.y * rs, hw.x * rs + hw.y * rc) + extra;
        vec2 c = P.tB[i].xy;
        if (c.x + hs.x >= lo.x && c.x - hs.x <= hi.x && c.y + hs.y >= lo.y && c.y - hs.y <= hi.y) {
            int k = atomicAdd(sTextN, 1);
            if (k < TILE_TEXT) sText[k] = i;
        }
    }
    barrier();
}

void main() {
    W = P.dims.x;
    H = P.dims.y;
    int padW = P.dims.z;
    int padH = P.dims.w;
    int bx = int(gl_GlobalInvocationID.x);
    int by = int(gl_GlobalInvocationID.y);
    int s = max(P.prev.x, 1);

    // Workgroup tile: 8x8 invocations of 4x2 pixels = 32x16 output pixels
    vec2 tlo = vec2(gl_WorkGroupID.xy * uvec2(32u, 16u)) * float(s) - 1.0;
    vec2 thi = tlo + vec2(32.0, 16.0) * float(s) + 2.0;
    buildTileLists(tlo, thi);

    if (s > 1) {
        // Reduced-resolution preview: each output pixel shades the center of its s x s cell
        int pw = P.prev.y, ph = P.prev.z;
        if (bx * 4 >= pw || by * 2 >= ph) return;
        for (int yy = 0; yy < 2; yy++) {
            for (int xx = 0; xx < 4; xx++) {
                ivec2 o = ivec2(bx * 4 + xx, by * 2 + yy);
                if (o.x >= pw || o.y >= ph) continue;
                vec2 q = min((vec2(o) + 0.5) * float(s) - 0.5, vec2(float(W - 1), float(H - 1)));
                outRGBA[o.y * pw + o.x] = packUnorm4x8(vec4(shade(q), 1.0));
            }
        }
        return;
    }
    if (bx * 4 >= padW || by * 2 >= padH) return;

    vec3 c[8];
    for (int yy = 0; yy < 2; yy++) {
        for (int xx = 0; xx < 4; xx++) {
            ivec2 pix = ivec2(bx * 4 + xx, by * 2 + yy);
            ivec2 src = min(pix, ivec2(W - 1, H - 1)); // padding by replicating the edge
            vec3 v = shade(vec2(src));
            c[yy * 4 + xx] = v;
            if (P.flags2.w != 0 && pix.x < W && pix.y < H) {
                outRGBA[pix.y * W + pix.x] = packUnorm4x8(vec4(v, 1.0));
            }
        }
    }

    int wordsPerRow = padW / 4;
    for (int yy = 0; yy < 2; yy++) {
        outY[(by * 2 + yy) * wordsPerRow + bx] = packBytes(
            lumaOf(c[yy * 4 + 0]), lumaOf(c[yy * 4 + 1]), lumaOf(c[yy * 4 + 2]), lumaOf(c[yy * 4 + 3]));
    }

    vec3 a = (c[0] + c[1] + c[4] + c[5]) * 0.25;
    vec3 b = (c[2] + c[3] + c[6] + c[7]) * 0.25;
    vec3 uvA = vec3(128.0) + 224.0 * vec3(dot(a, vec3(-0.1146, -0.3854, 0.5)), dot(a, vec3(0.5, -0.4542, -0.0458)), 0.0);
    vec3 uvB = vec3(128.0) + 224.0 * vec3(dot(b, vec3(-0.1146, -0.3854, 0.5)), dot(b, vec3(0.5, -0.4542, -0.0458)), 0.0);
    outUV[by * wordsPerRow + bx] = packBytes(uvA.x, uvA.y, uvB.x, uvB.y);
}
