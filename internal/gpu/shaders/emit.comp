#version 450
#extension GL_GOOGLE_include_directive : require
// Emitter pass (particle emitters, see internal/effects/emit.go: same math, in float32):
// The emitters go in batches (as many as the accumulations: push constant n), each running the
// four phases with its first emitter e0; their light fields (all the emitters', read by
// render.comp) are after the batch's accumulations, so any number of emitters fits:
//   phase 0: clear the accumulations
//   phase 1: one invocation per particle: its state from its birth and age, splatted into its
//            emitter's accumulation with integer atomic adds (the sum does not depend on order)
//   phase 2: one invocation per pixel and emitter: the sums → premultiplied RGBA8 (plain, or the
//            flame look; plus the glow), written as the emitter clip's image in the overlay
//            buffer, which render.comp then composites
// Each emitter's accumulation: its particles (4 words per cell of Div×Div px), then its glow
// (4 words per 8×8 px)
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Push { int phase, e0, n; } pc;

layout(std430, set = 0, binding = 9) buffer Layers { uint lay[]; }; // (read: the gas look's grid)
layout(std430, set = 0, binding = 10) buffer Acc { uint acc[]; };
layout(std430, set = 0, binding = 11) readonly buffer EData { uint ed[]; };

const int ESTRIDE = 128; // words per emitter header
const int BW = 10;       // words per birth (gpu.EmitBirthWords)
const float FIXED = 1024.0;

float edf(int i) { return uintBitsToFloat(ed[i]); }
ivec4 edi4(int i) { return ivec4(ed[i], ed[i + 1], ed[i + 2], ed[i + 3]); }
vec4 edf4(int i) { return vec4(edf(i), edf(i + 1), edf(i + 2), edf(i + 3)); }

uint pcg(uint v) {
    uint s = v * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}
float rnd(uint seed, int i, uint j) { return float(pcg(seed ^ pcg(uint(i) * 16u + j))) * (1.0 / 4294967296.0); }

int W, H, NE;
int E0, E1; // this batch: emitters e0 to e1 - 1

// Emitter e's header: word offset
int eh(int e) { return 4 + e * ESTRIDE; }

const int GDIV = 8;  // the glow's cells
const int XDIV = 32; // the light's cells
int LW, LH, XW, XH;  // the glow grid, the light grid
// Word offsets of emitter e's accumulation (its place in the batch), its glow, its light
// sources, its particles' depth × their weight; then its light field, after the accumulations
// of a batch (as effects.EmitAccLayout)
uint accStride() { return uint(W * H * 4 + LW * LH * 4 + XW * XH + W * H); }
uint accBase(int e) { return uint(e - E0) * accStride(); }
uint glowBase(int e) { return accBase(e) + uint(W * H * 4); }
uint srcBase(int e) { return glowBase(e) + uint(LW * LH * 4); }
uint zBase(int e) { return srcBase(e) + uint(XW * XH); }
uint fieldBase(int e) { return uint(pc.n) * accStride() + uint(e) * uint(XW * XH); }

// The easings of keys (as config.Ease) and a value along a path (as effects.PathTrack.At): at
// off in the emitter data, n, then n lengths, values and easings
float easeK(int e, float k) {
    k = clamp(k, 0.0, 1.0);
    if (e == 1) return 0.0;
    if (e == 2) return k * k * k;
    if (e == 3) return 1.0 - pow(1.0 - k, 3.0);
    if (e == 4) return k < 0.5 ? 4.0 * k * k * k : 1.0 - pow(-2.0 * k + 2.0, 3.0) / 2.0;
    if (e == 5) {
        const float c = 1.70158 * 1.525;
        if (k < 0.5) return (2.0 * k) * (2.0 * k) * ((c + 1.0) * 2.0 * k - c) / 2.0;
        return ((2.0 * k - 2.0) * (2.0 * k - 2.0) * ((c + 1.0) * (2.0 * k - 2.0) + c) + 2.0) / 2.0;
    }
    if (e == 6) return k >= 1.0 ? 1.0 : 1.0 - exp(-6.0 * k) * cos(4.5 * 3.14159265 * k);
    return k;
}
float trackAtE(int off, float s) {
    int n = int(edf(off));
    int so = off + 1, vo = off + 1 + n, eo = off + 1 + 2 * n;
    if (s <= edf(so)) return edf(vo);
    if (s >= edf(so + n - 1)) return edf(vo + n - 1);
    int j = 1;
    while (j < n - 1 && edf(so + j) < s) j++;
    float k = (s - edf(so + j - 1)) / max(edf(so + j) - edf(so + j - 1), 1e-6);
    return edf(vo + j - 1) + (edf(vo + j) - edf(vo + j - 1)) * easeK(int(edf(eo + j - 1)), k);
}
// a length along a path of length L, round when closed
float wrapLen(float s, float L, bool closed) { return closed && L > 0.0 ? s - L * floor(s / L) : s; }

// Every phase runs THREADS invocations (4096 groups of 64), each looping over its items
const uint THREADS = 4096u * 64u;

void clearPhase() {
    uint n = uint(E1 - E0) * accStride();
    for (uint k = gl_GlobalInvocationID.x; k < n; k += THREADS) acc[k] = 0u;
}

void addCell(uint o, vec3 c, float w) {
    if (w <= 0.0) return;
    uint qr = uint(c.r * w * FIXED + 0.5), qg = uint(c.g * w * FIXED + 0.5);
    uint qb = uint(c.b * w * FIXED + 0.5), qa = uint(w * FIXED + 0.5);
    if (qr > 0u) atomicAdd(acc[o], qr);
    if (qg > 0u) atomicAdd(acc[o + 1u], qg);
    if (qb > 0u) atomicAdd(acc[o + 2u], qb);
    if (qa > 0u) atomicAdd(acc[o + 3u], qa);
}

// the launch and the forces at time t: displacement and velocity (closed form, with drag k)
vec4 motionAt(float t, vec2 v0, vec2 a, float k) {
    if (k > 1e-3) {
        float ek = exp(-k * t);
        float g = (1.0 - ek) / k;
        return vec4(v0 * g + a * (t - g) / k, v0 * ek + a * g);
    }
    return vec4(v0 * t + 0.5 * a * t * t, v0 + a * t);
}
// the point at length s along a sampled path (x, y, length so far; n samples at word o) and its
// unit tangent; past its ends straight on (round, closed). As effects.pathPoint
vec4 pathPoint(int o, int n, float L, bool closed, float s) {
    if (closed && L > 0.0) s -= L * floor(s / L);
    int lo = 1, hi = n - 1;
    while (lo < hi) {
        int m = (lo + hi) / 2;
        if (edf(o + m * 3 + 2) >= s) hi = m; else lo = m + 1;
    }
    int a = o + (lo - 1) * 3, b = o + lo * 3;
    float dl = max(edf(b + 2) - edf(a + 2), 1e-6);
    float f = (s - edf(a + 2)) / dl;
    vec2 pa = vec2(edf(a), edf(a + 1)), pb = vec2(edf(b), edf(b + 1));
    return vec4(pa + (pb - pa) * f, (pb - pa) / dl);
}

// how much of a particle at p with depth z is seen: the scene's depth on screen (a grid at
// ed[h+99]-1: OGW×OGH cells of ODiv px, 0…1 near) nearer than it hides it, with the soft edge
// f[h+103] (as EmitParams.occl)
float occlAt(int h, vec2 p, float z) {
    uint o = ed[h + 99];
    if (o == 0u || z < 0.0) return 1.0;
    int gw = int(ed[h + 100]), gh = int(ed[h + 101]);
    float d = float(ed[h + 102]), soft = edf(h + 103);
    vec2 q = clamp(p / d - 0.5, vec2(0.0), vec2(float(gw - 1), float(gh - 1)));
    ivec2 i = max(min(ivec2(q), ivec2(gw - 2, gh - 2)), ivec2(0));
    vec2 f = q - vec2(i);
    int b = int(o) - 1;
    float a00 = edf(b + i.y * gw + i.x), a10 = edf(b + i.y * gw + min(i.x + 1, gw - 1));
    float a01 = edf(b + min(i.y + 1, gh - 1) * gw + i.x), a11 = edf(b + min(i.y + 1, gh - 1) * gw + min(i.x + 1, gw - 1));
    float s = mix(mix(a00, a10, f.x), mix(a01, a11, f.x), f.y);
    return 1.0 - smoothstep(z - soft, z + soft + 1e-4, s);
}

// what they go round: the signed distance (px, < 0 inside) at p, bilinear on the grid at word o
// (gw×gh cells of dv px); a particle inside comes out at the surface, losing the speed that went
// in (as EmitParams.collide)
float sdfAt(int o, int gw, int gh, float dv, vec2 p) {
    vec2 q = p / dv - 0.5;
    ivec2 i0 = ivec2(floor(q));
    vec2 f = q - vec2(i0);
    float v[4];
    for (int k = 0; k < 4; k++) {
        ivec2 c = clamp(i0 + ivec2(k & 1, k >> 1), ivec2(0), ivec2(gw - 1, gh - 1));
        v[k] = edf(o + c.y * gw + c.x);
    }
    float a = v[0] + (v[1] - v[0]) * f.x, b = v[2] + (v[3] - v[2]) * f.x;
    return a + (b - a) * f.y;
}


// ---- expressions worked out per particle (expr.glsl)
#define XPW(i) ed[i]
#include "expr.glsl"
// the particle (exprRun's): how many (count), its route / path for its own values (path.x …):
// its samples, count, length, closed, how far the route is moved (to where it was born), how far
// along its route / path it is
int xcount = 1;
int xpo = 0, xns = 0;
float xL = 0.0;
bool xclosed = false;
vec2 xshift = vec2(0.0);
float xSR = 0.0, xSP = 0.0;
// (a color worked out channel by channel: the emitter's, as the expression's value)
vec4 xBase = vec4(0.0);
bool xColor = false;
float xVar(int v) {
    if (v == 6) return float(xIndex);
    if (v == 7) return float(xcount);
    if (!xColor) return 0.0;
    if (v == 0) return xBase[clamp(xCh, 0, 3)];
    if (v == 9) return float(xCh);
    if (v >= 10 && v <= 13) return xBase[v - 10];
    return 0.0;
}
bool xKey(int kind, uint tu, out float v) {
    v = 0.0;
    if (tu >= 0xFFFFFFF0u) {
        // the route's / path's own: where it is on it (as effects.PathBuiltinAt)
        int b = int(tu - 0xFFFFFFF0u);
        float s = wrapLen(kind == 1 ? xSR : xSP, xL, xclosed);
        vec4 pt = pathPoint(xpo, xns, xL, xclosed, s);
        vec2 shv = kind == 1 ? xshift : vec2(0.0);
        v = b == 1 ? (pt.x + shv.x) / float(W) : b == 2 ? (pt.y + shv.y) / float(H)
            : b == 3 ? (xL > 0.0 ? clamp(s / xL, 0.0, 1.0) : 0.0) : atan(pt.w, pt.z) / XDEG;
        return true;
    }
    if (tu > 0u) { v = trackAtE(int(tu) - 1, kind == 1 ? xSR : xSP); return true; }
    return false;
}
// runs expression d (its 6 words: property, code, length, consts, key table, multiplier) for item
// index at sRoute / sPath along its route / path; nil gives 0 (as effects.particleExprs)
// a color (color: from the emitter's base) is worked out channel by channel (n = 4), a number
// once (as effects.particleExprs); one call of the interpreter (the driver inlines it)
vec4 exprRun(int d, int index, float sRoute, float sPath, uint seed, uint frame, bool color, vec4 base) {
    xIndex = index; xSR = sRoute; xSP = sPath; xSeed = seed; xFrame = frame;
    xColor = color; xBase = base; xValA = color ? base.a : 0.0;
    vec4 o = vec4(0.0);
    int n = color ? 4 : 1;
    for (int c = 0; c < n; c++) {
        xCh = c;
        o[c] = xRun(int(ed[d + 1]), int(ed[d + 2]), int(ed[d + 3]), int(ed[d + 4]));
    }
    xColor = false;
    return o;
}

// draws one particle of emitter e (header h) at pos with its velocity, size, color and depth
// (-1: none): into its accumulation (dv px cells, GW×GH), its depth, its light source, its halo
void drawParticle(int e, int h, vec2 pos, vec2 vel, float size, vec4 col, float pz, vec4 fd, int dv, int GW, int GH) {
    // hidden where the scene is nearer than it (its own depth: each particle by itself)
    col.a *= occlAt(h, pos, pz);
    if (col.a <= 0.0) return;
    float r = size * 0.5;
    float tiny = r >= 0.7 ? 1.0 : (r * r) / (0.7 * 0.7);
    if (r < 0.7) r = 0.7;
    vec2 st = vel * fd.z;
    int px0 = max(int(floor(min(pos.x, pos.x - st.x) - r - 1.0)) / dv, 0);
    int px1 = min(int(ceil(max(pos.x, pos.x - st.x) + r + 1.0)) / dv + 1, GW - 1);
    int py0 = max(int(floor(min(pos.y, pos.y - st.y) - r - 1.0)) / dv, 0);
    int py1 = min(int(ceil(max(pos.y, pos.y - st.y) + r + 1.0)) / dv + 1, GH - 1);
    float alpha = col.a * tiny;
    float edge = max(r * fd.w, 0.5);
    float l2 = dot(st, st);
    uint base = accBase(e);
    // the gas look: its particles are not drawn (they feed the gas; only their light and glow)
    if (ed[h + 43] >= 4u) py1 = py0 - 1;
    for (int yy = py0; yy <= py1; yy++) {
        for (int xx = px0; xx <= px1; xx++) {
            vec2 q = (vec2(float(xx), float(yy)) + 0.5) * float(dv) - pos;
            if (l2 > 0.0) {
                float t = clamp(-dot(q, st) / l2, 0.0, 1.0);
                q += st * t;
            }
            float dd = length(q);
            float w = (1.0 - smoothstep(r - edge, r, dd)) * alpha;
            addCell(base + uint(yy * GW + xx) * 4u, col.rgb, w);
            if (pz >= 0.0) {
                uint zq = uint(pz * w * FIXED + 0.5);
                if (zq > 0u) atomicAdd(acc[zBase(e) + uint(yy * GW + xx)], zq);
            }
        }
    }
    // its light source: its cell of the light grid
    if (ed[h + 64] != 0u && ed[h + 43] != 4u) { // (the gas look: its flames are the sources)
        int lx = int(floor(pos.x / float(XDIV))), ly = int(floor(pos.y / float(XDIV)));
        uint q = uint(col.a * tiny * FIXED + 0.5);
        if (q > 0u && lx >= 0 && ly >= 0 && lx < XW && ly < XH) atomicAdd(acc[srcBase(e) + uint(ly * XW + lx)], q);
    }
    // the halo: the disc grown by the glow's reach, fading out, on the coarse glow grid
    float gI = edf(h + 58), gR = edf(h + 59);
    if (gI > 0.0 && gR > 0.0) {
        float rg = size * 0.5 + gR;
        float gd = float(GDIV);
        int gx0 = max(int(floor((pos.x - rg) / gd)), 0), gx1 = min(int(ceil((pos.x + rg) / gd)), LW - 1);
        int gy0 = max(int(floor((pos.y - rg) / gd)), 0), gy1 = min(int(ceil((pos.y + rg) / gd)), LH - 1);
        uint gb = glowBase(e);
        float norm = gd * gd / (0.25 * 3.14159265 * rg * rg); // the same light whatever the reach
        for (int yy = gy0; yy <= gy1; yy++) {
            for (int xx = gx0; xx <= gx1; xx++) {
                vec2 q = (vec2(float(xx), float(yy)) + 0.5) * gd - pos;
                float ff2 = 1.0 - smoothstep(0.0, rg, length(q));
                addCell(gb + uint(yy * LW + xx) * 4u, col.rgb, alpha * norm * ff2 * ff2);
            }
        }
    }
}

void splatOne(int j) {
    int e = -1, i = 0;
    for (int k = E0; k < E1; k++) {
        ivec4 v0 = edi4(eh(k));
        if (j >= v0.x && j < v0.x + v0.z) { e = k; i = v0.y + (j - v0.x); break; }
    }
    if (e < 0) return;
    int h = eh(e);
    ivec4 v0 = edi4(h), v1 = edi4(h + 4);
    vec4 shp = edf4(h + 8), sp = edf4(h + 12), ph = edf4(h + 16), lf = edf4(h + 20);
    vec4 c0 = edf4(h + 24), c1 = edf4(h + 28), c2 = edf4(h + 32), fd = edf4(h + 36);
    uint seed = ed[h + 40];
    float T = edf(h + 41);
    int dv = int(ed[h + 42]);
    int GW = (W + dv - 1) / dv, GH = (H + dv - 1) / dv;

    uint so = ed[h + 120];
    if (so != 0u) {
        // simulated particles (the liquid look): their state as uploaded after the emitter's
        // image (x, y, vx, vy, size, r, g, b, a, depth: -1 none)
        uint o = so - 1u + uint(i) * 10u;
        vec2 spos = vec2(uintBitsToFloat(lay[o]), uintBitsToFloat(lay[o + 1u]));
        vec2 svel = vec2(uintBitsToFloat(lay[o + 2u]), uintBitsToFloat(lay[o + 3u]));
        vec4 scol = vec4(uintBitsToFloat(lay[o + 5u]), uintBitsToFloat(lay[o + 6u]), uintBitsToFloat(lay[o + 7u]), uintBitsToFloat(lay[o + 8u]));
        if (scol.a > 0.0) drawParticle(e, h, spos, svel, uintBitsToFloat(lay[o + 4u]), scol, uintBitsToFloat(lay[o + 9u]), fd, dv, GW, GH);
        return;
    }

    // birth: the first table entry whose count reaches i + 0.5
    int bo = v0.w, nb = v1.x;
    float x = float(i) + 0.5;
    if (nb < 2 || x <= edf(bo + 1) || x > edf(bo + (nb - 1) * BW + 1)) return;
    int lo = 0, hi = nb - 1;
    while (lo < hi) {
        int m = (lo + hi) / 2;
        if (edf(bo + m * BW + 1) >= x) hi = m; else lo = m + 1;
    }
    int ia = bo + (lo - 1) * BW, ib = bo + lo * BW;
    float d = edf(ib + 1) - edf(ia + 1);
    float f = d > 0.0 ? (x - edf(ia + 1)) / d : 0.0;
    float bT = edf(ia) + (edf(ib) - edf(ia)) * f;
    float bX = edf(ia + 2) + (edf(ib + 2) - edf(ia + 2)) * f;
    float bY = edf(ia + 3) + (edf(ib + 3) - edf(ia + 3)) * f;
    float bR = edf(ia + 4) + (edf(ib + 4) - edf(ia + 4)) * f;
    float bS = edf(ia + 5) + (edf(ib + 5) - edf(ia + 5)) * f;
    float bZ = edf(ia + 6) + (edf(ib + 6) - edf(ia + 6)) * f;
    float bSc = edf(ia + 7) + (edf(ib + 7) - edf(ia + 7)) * f; // the shape's scale (a text's size)
    float bP = edf(ia + 8) + (edf(ib + 8) - edf(ia + 8)) * f;  // where on its motion path

    // its own values (expressions per particle), else the emitter's (as effects.particleExprs)
    int xb = int(ed[h + 96]);
    if (xb > 0) {
        float age0 = max(T - bT, 0.0);
        float spd0 = sp.x * (1.0 + sp.y * (2.0 * rnd(seed, i, 4u) - 1.0)) * bS;
        float along0 = spd0 * age0;
        if (ph.x > 1e-3) along0 = spd0 * (1.0 - exp(-ph.x * age0)) / ph.x;
        float PL = edf(h + 71);
        bool pclosed = (ed[h + 72] & 1u) != 0u;
        float sR = wrapLen(along0, PL, pclosed), sPa = wrapLen(bP * PL + along0, PL, pclosed);
        uint frame = ed[h + 97];
        xcount = int(ed[h + 98]);
        xpo = int(ed[h + 69]); xns = int(ed[h + 70]); xL = PL; xclosed = pclosed;
        xshift = (ed[h + 72] & 8u) != 0u && xns >= 2 ? vec2(bX, bY) - vec2(edf(xpo), edf(xpo + 1)) : vec2(0.0);
        int np = int(ed[xb - 1]);
        for (int q = 0; q < np; q++) {
            int d = xb - 1 + 1 + 6 * q;
            int prop = int(ed[d]);
            bool isCol = prop >= 9; // a color of its own: birth, middle, end
            vec4 r = exprRun(d, i, sR, sPa, seed, frame, isCol, prop == 9 ? c0 : prop == 10 ? c1 : c2);
            if (isCol) {
                r = clamp(r, 0.0, 1.0);
                if (prop == 9) c0 = r; else if (prop == 10) c1 = r; else c2 = r;
                continue;
            }
            float v = r.x * edf(d + 5);
            if (prop == 0) sp.x = v;
            else if (prop == 1) ph.w = v;
            else if (prop == 2) lf.y = v;
            else if (prop == 3) lf.z = v;
            else if (prop == 4) sp.z = v;
            else if (prop == 5) sp.w = v;
            else if (prop == 6) ph.y = v;
            else if (prop == 7) shp.z = v;
            else if (prop == 8) shp.w = v;
        }
    }
    float life = ph.w * (1.0 + lf.x * (2.0 * rnd(seed, i, 0u) - 1.0));
    if (life < 0.05) life = 0.05;
    float age = T - bT;
    if (age < 0.0 || age >= life) return;
    float u = age / life;
    float rc = cos(bR), rs = sin(bR);
    float ox = 0.0, oy = 0.0;
    int shape = v1.z;
    if (shape == 1 || shape == 2) {
        float rad = shp.x * 0.5;
        if (shape == 1) rad *= sqrt(rnd(seed, i, 1u));
        float a = 6.2831855 * rnd(seed, i, 2u);
        ox = rad * cos(a); oy = rad * sin(a);
    } else if (shape == 3) {
        ox = (rnd(seed, i, 1u) - 0.5) * shp.x;
    } else if (shape == 4) {
        ox = (rnd(seed, i, 1u) - 0.5) * shp.x; oy = (rnd(seed, i, 2u) - 0.5) * shp.y;
    } else if (shape == 5) {
        // a point on the letters of a text (a pixel aside), at the text's size then
        int np = int(ed[h + 68]);
        if (np > 0) {
            int kp = min(int(rnd(seed, i, 1u) * float(np)), np - 1);
            int po = int(ed[h + 67]) + kp * 2;
            ox = (edf(po) + (rnd(seed, i, 2u) - 0.5) * 1.5) * bSc;
            oy = (edf(po + 1) + (rnd(seed, i, 10u) - 0.5) * 1.5) * bSc;
        }
    }
    float x0 = bX + ox * rc - oy * rs, y0 = bY + ox * rs + oy * rc;
    // launch direction: turned with the emitter, not with a text it is born on
    float a = shp.z + (shape == 5 ? 0.0 : bR) + (rnd(seed, i, 3u) - 0.5) * shp.w;
    float spd = sp.x * (1.0 + sp.y * (2.0 * rnd(seed, i, 4u) - 1.0)) * bS;
    vec2 v0l = vec2(spd * sin(a), -spd * cos(a));
    vec2 acc2 = vec2(sp.w, sp.z); // wind, gravity
    float k = ph.x;
    vec4 mv = motionAt(age, v0l, acc2, k);
    vec2 dp = mv.xy, vel = mv.zw;
    int nsamp = int(ed[h + 70]);
    int zt = int(ed[h + 95]); // the depth along their path (offset + 1; 0: none)
    float pz = -1.0;
    uint flg = ed[h + 72];
    if (nsamp >= 2 && (flg & 4u) == 0u) {
        // along the motion path: as far as its speed takes it, its shape's cross offset, the forces
        float along = spd * age, sv = spd;
        if (k > 1e-3) {
            float ek = exp(-k * age);
            along = spd * (1.0 - ek) / k;
            sv = spd * ek;
        }
        float L = edf(h + 71);
        vec4 pt = pathPoint(int(ed[h + 69]), nsamp, L, (flg & 1u) != 0u, bP * L + along);
        if (zt > 0) pz = trackAtE(zt - 1, wrapLen(bP * L + along, L, (flg & 1u) != 0u));
        vec4 fm = motionAt(age, vec2(0.0), acc2, k);
        x0 = pt.x - pt.w * ox;
        y0 = pt.y + pt.z * ox;
        dp = fm.xy;
        vel = pt.zw * sv + fm.zw;
    } else if ((flg & 2u) != 0u && acc2.y > 0.0 && y0 < edf(h + 73) && y0 + dp.y > edf(h + 73)) {
        // it reached the floor: the moment (halving), then bounces losing speed
        float fl = edf(h + 73);
        float lo2 = 0.0, hi2 = age;
        for (int it = 0; it < 14; it++) {
            float m = 0.5 * (lo2 + hi2);
            if (y0 + motionAt(m, v0l, acc2, k).y > fl) hi2 = m; else lo2 = m;
        }
        float t1 = hi2;
        vec4 m1 = motionAt(t1, v0l, acc2, k);
        float fr = edf(h + 75), bo2 = edf(h + 74);
        float tau = age - t1, v = bo2 * max(m1.w, 0.0);
        float ry = 0.0, rvy = 0.0;
        for (int b = 0; b < 16; b++) {
            float flight = 2.0 * v / acc2.y;
            if (v < 1.0) break;
            if (tau < flight) {
                ry = v * tau - 0.5 * acc2.y * tau * tau;
                rvy = v - acc2.y * tau;
                break;
            }
            tau -= flight;
            v *= bo2;
        }
        dp = vec2(m1.x + m1.z * fr * (age - t1), fl - y0 - ry);
        vel = vec2(m1.z * fr, -rvy);
    }
    float rk = edf(h + 93);
    if (nsamp >= 2 && (flg & 4u) != 0u && rk > 0.0) {
        // their own route, from its start (moved to where they are born unless fixed): as far
        // along it as they would have gone free (Simpson over their speed), mixed with their
        // free motion
        float hs = age / 8.0;
        float along = length(v0l) + length(motionAt(age, v0l, acc2, k).zw);
        for (int j = 1; j < 8; j++) along += float(2 + 2 * (j & 1)) * length(motionAt(float(j) * hs, v0l, acc2, k).zw);
        along *= hs / 3.0;
        float sv = length(motionAt(age, v0l, acc2, k).zw);
        int po = int(ed[h + 69]);
        vec4 pt = pathPoint(po, nsamp, edf(h + 71), (flg & 1u) != 0u, along);
        if (zt > 0) pz = trackAtE(zt - 1, wrapLen(along, edf(h + 71), (flg & 1u) != 0u));
        if ((flg & 8u) != 0u) pt.xy += vec2(bX, bY) - vec2(edf(po), edf(po + 1));
        vec2 rp = vec2(pt.x - pt.w * ox, pt.y + pt.z * ox);
        float m = min(rk, 1.0);
        dp += m * (rp - (vec2(x0, y0) + dp));
        vel += m * (pt.zw * sv - vel);
    }
    if (ph.y > 0.0) {
        float wv = 6.2831855 * ph.z;
        vec2 wav;
        for (int ax = 0; ax < 2; ax++) {
            uint jj = ax == 0 ? 5u : 7u;
            float p1 = 6.2831855 * rnd(seed, i, jj), p2 = 6.2831855 * rnd(seed, i, jj + 1u);
            float s = sin(wv * age + p1) - sin(p1);
            s += 0.5 * (sin(2.13 * wv * age + p2) - sin(p2));
            wav[ax] = s / 1.5;
        }
        dp += ph.y * wav;
    }
    float size = (lf.y + (lf.z - lf.y) * u) * (1.0 + lf.w * (2.0 * rnd(seed, i, 9u) - 1.0)) * bZ;
    size = max(size, 0.0);
    vec4 ca = c0, cb = c1;
    float ff = u * 2.0;
    if (u >= 0.5) { ca = c1; cb = c2; ff = (u - 0.5) * 2.0; }
    vec4 col = ca + (cb - ca) * ff;
    if (fd.x > 0.0) col.a *= min(1.0, u / fd.x);
    if (fd.y > 0.0) col.a *= min(1.0, (1.0 - u) / fd.y);
    if (col.a <= 0.0) return;

    vec2 pos = vec2(x0, y0) + dp;
    int cgw = int(ed[h + 81]);
    for (int pass = 0; pass < 2 && cgw > 0; pass++) {
        // twice: out of one thing it may land in another close by
        int co = int(ed[h + 80]), cgh = int(ed[h + 82]);
        float cd = float(ed[h + 83]);
        float dd = sdfAt(co, cgw, cgh, cd, pos);
        if (dd < 0.0) {
            vec2 g = vec2(sdfAt(co, cgw, cgh, cd, pos + vec2(cd, 0.0)) - sdfAt(co, cgw, cgh, cd, pos - vec2(cd, 0.0)),
                          sdfAt(co, cgw, cgh, cd, pos + vec2(0.0, cd)) - sdfAt(co, cgw, cgh, cd, pos - vec2(0.0, cd)));
            float gl = length(g);
            if (gl >= 1e-6) {
                vec2 n = g / gl;
                float eb = edf(h + 84);
                float vn = dot(vel, n);
                if (eb > 0.0 && n.y > -0.5) {
                    // off a wall or a ceiling: mirrored across it, keeping eb of the speed in
                    pos += n * (-dd) * (1.0 + eb);
                    if (vn < 0.0) vel -= (1.0 + eb) * vn * n;
                } else {
                    pos += n * (0.5 - dd);
                    if (vn < 0.0) vel -= n * vn;
                }
            }
        }
    }
    drawParticle(e, h, pos, vel, size, col, pz, fd, dv, GW, GH);
}

vec4 cellSum(uint base, int GW, int GH, int cx, int cy) {
    cx = clamp(cx, 0, GW - 1);
    cy = clamp(cy, 0, GH - 1);
    uint o = base + uint(cy * GW + cx) * 4u;
    return vec4(float(acc[o]), float(acc[o + 1u]), float(acc[o + 2u]), float(acc[o + 3u])) / FIXED;
}

// The sums at a point (px), bilinear between the cells of dv px
vec4 sumAt(uint base, int GW, int GH, int dv, vec2 p) {
    vec2 q = p / float(dv) - 0.5;
    ivec2 i0 = ivec2(floor(q));
    vec2 f = q - vec2(i0);
    vec4 a = cellSum(base, GW, GH, i0.x, i0.y), b = cellSum(base, GW, GH, i0.x + 1, i0.y);
    vec4 c = cellSum(base, GW, GH, i0.x, i0.y + 1), d = cellSum(base, GW, GH, i0.x + 1, i0.y + 1);
    vec4 ab = a + (b - a) * f.x, cd = c + (d - c) * f.x;
    return ab + (cd - ab) * f.y;
}

// Value noise (as effects.evnoise)
float hash2(int ix, int iy, uint seed) {
    return float(pcg(uint(ix) * 1597334677u ^ uint(iy) * 3812015801u ^ seed)) * (1.0 / 4294967296.0);
}
float vnoise(vec2 p, uint seed) {
    vec2 fl = floor(p);
    int ix = int(fl.x), iy = int(fl.y);
    vec2 u = p - fl;
    u = u * u * (3.0 - 2.0 * u);
    float a = hash2(ix, iy, seed), b = hash2(ix + 1, iy, seed);
    float c = hash2(ix, iy + 1, seed), d = hash2(ix + 1, iy + 1, seed);
    return a + (b - a) * u.x + (c - a) * u.y + (a - b - c + d) * u.x * u.y;
}
float fbm(vec2 p, uint seed) {
    float v = 0.5 * vnoise(p, seed);
    v += 0.25 * vnoise(vec2(2.0 * p.x + 5.2, 2.0 * p.y + 1.3), seed);
    v += 0.125 * vnoise(vec2(4.0 * p.x + 1.7, 4.0 * p.y + 9.2), seed);
    return v / 0.875;
}

// The water look (as effects.waterPixel): the particles' weight piled up is a height; past the
// threshold it is liquid, its slope a surface lit from the top left, see through in its body and
// denser at its edges, moved by ripples
// (gLens: where what is under it is seen from, moved px)
vec2 gLens = vec2(0.0);
vec4 waterPixel(int h, uint base, int GW, int GH, int dv, vec2 pp, float T, uint seed) {
    float sc = max(edf(h + 91), 1.0);
    float tt = T * edf(h + 92) / sc;
    float rp = edf(h + 90);
    vec2 q = pp + rp * (vec2(fbm(vec2(pp.x / sc + tt, pp.y / sc), seed + 31u),
                             fbm(vec2(pp.x / sc + 3.7, pp.y / sc - tt + 5.3), seed + 31u)) - 0.5) * 2.0;
    vec4 s = sumAt(base, GW, GH, dv, q);
    float th = max(edf(h + 86), 0.01);
    if (s.a < th * 0.7) return vec4(0.0);
    float al = smoothstep(th * 0.8, th * 1.15, s.a);
    float e = float(max(dv, 2));
    float gx = (sumAt(base, GW, GH, dv, q + vec2(e, 0.0)).a - sumAt(base, GW, GH, dv, q - vec2(e, 0.0)).a) / (2.0 * e);
    float gy = (sumAt(base, GW, GH, dv, q + vec2(0.0, e)).a - sumAt(base, GW, GH, dv, q - vec2(0.0, e)).a) / (2.0 * e);
    float k = edf(h + 89);
    vec3 n = normalize(vec3(-gx * k, -gy * k, 1.0));
    float ndl = max(0.0, dot(n, vec3(-0.4319, -0.5758, 0.6943)));
    float spec = pow(max(0.0, dot(n, vec3(-0.2357, -0.3143, 0.9196))), 48.0) * edf(h + 88);
    float fr = (1.0 - n.z) * (1.0 - n.z);
    float clr = clamp(edf(h + 87), 0.0, 1.0);
    float body = (1.0 - clr) + clr * min(1.0, fr * 1.2) * 0.6;
    vec3 b = s.rgb / s.a;
    vec3 col = (b * (0.55 + 0.6 * ndl) * body + (b * 0.5 + 0.5) * fr * 0.4 * (1.0 - 0.85 * clr) + spec) * al;
    gLens = -n.xy * edf(h + 94) * al; // a lens: seen from towards its middle
    return vec4(col, max(al * body, max(col.r, max(col.g, col.b))));
}

// The gas look (as effects.gasPixel): its grid (GasFrame) in the overlay buffer at ed[h+104]-1,
// ed[h+105]×ed[h+106] cells of edf(h+107) px, 6 words (pairs of halves) per cell: smoke, heat;
// the light reaching it, the light around it; the fire's light, red; green, blue (× smoke); the
// two sets of wisp coordinates
float gasV[14];
void gasCell(int o, int gw, int gh, int i, int j, float w) {
    i = clamp(i, 0, gw - 1);
    j = clamp(j, 0, gh - 1);
    int c = o + (j * gw + i) * 7;
    for (int k = 0; k < 7; k++) {
        vec2 v = unpackHalf2x16(lay[c + k]);
        gasV[2 * k] += w * v.x;
        gasV[2 * k + 1] += w * v.y;
    }
}
float gasNoise(vec2 p, uint seed) {
    return 0.7 * fbm(p, seed) + 0.3 * fbm(vec2(2.7 * p.x + 5.1, 2.7 * p.y + 1.9), seed + 7u);
}
vec3 flameRamp(int h, float ht) {
    vec3 cool = vec3(edf(h + 44), edf(h + 45), edf(h + 46));
    vec3 mid = vec3(edf(h + 47), edf(h + 48), edf(h + 49));
    vec3 hot = vec3(edf(h + 50), edf(h + 51), edf(h + 52));
    if (ht < 0.35) return cool;
    if (ht < 0.7) return cool + (mid - cool) * ((ht - 0.35) / 0.35);
    return mid + (hot - mid) * ((ht - 0.7) / 0.3);
}
float gGasZ = -1.0; // (gasPixel: the gas's depth here; -1 none)
vec4 gasPixel(int h, vec2 pp, uint seed, float T) {
    gGasZ = -1.0;
    int o = int(ed[h + 104]) - 1;
    if (o < 0) return vec4(0.0);
    int gw = int(ed[h + 105]), gh = int(ed[h + 106]);
    float cs = edf(h + 107);
    vec2 q = pp / cs - 0.5;
    vec2 cc = floor(q + 0.5);
    vec2 t = q - cc;
    vec3 wx = vec3(0.5 * (0.5 - t.x) * (0.5 - t.x), 0.75 - t.x * t.x, 0.5 * (0.5 + t.x) * (0.5 + t.x));
    vec3 wy = vec3(0.5 * (0.5 - t.y) * (0.5 - t.y), 0.75 - t.y * t.y, 0.5 * (0.5 + t.y) * (0.5 + t.y));
    for (int k = 0; k < 14; k++) gasV[k] = 0.0;
    for (int j = 0; j < 3; j++)
        for (int i = 0; i < 3; i++) gasCell(o, gw, gh, int(cc.x) + i - 1, int(cc.y) + j - 1, wx[i] * wy[j]);
    float d0 = gasV[0], heat = gasV[1];
    // the heat haze (as effects.gasPixel): where the air is warm, what is behind it shimmers
    float hz = edf(h + 121);
    if (hz > 0.0 && gasV[12] > 1e-4) {
        float k = hz * (1.0 - exp(-gasV[12] * 1.5));
        float hs = max(edf(h + 122), 1.0);
        vec2 u = vec2(pp.x / hs, pp.y / hs + T * 3.0);
        gLens = vec2(k * (2.0 * fbm(u, seed + 51u) - 1.0), k * (2.0 * fbm(vec2(u.x + 7.1, u.y + 3.7), seed + 51u) - 1.0));
    }
    if (d0 < 1e-4 && heat < 1e-4) return vec4(0.0);
    float sc = max(edf(h + 111), 1.0);
    float w1 = edf(h + 108), w2 = 1.0 - w1;
    float na = gasNoise(vec2((pp.x + gasV[8]) / sc, (pp.y + gasV[9]) / sc), seed + 41u);
    float nb = gasNoise(vec2((pp.x + gasV[10]) / sc + 31.7, (pp.y + gasV[11]) / sc + 17.1), seed + 41u);
    float n = w1 * na + w2 * nb;
    n = 0.5 + (n - 0.5) / sqrt(w1 * w1 + w2 * w2);
    float wsp = edf(h + 110);
    float d = max(0.0, d0 * (1.0 + wsp * 2.4 * (n - 0.5)) - wsp * 0.12 * (1.0 - n));
    float al = 1.0 - exp(-edf(h + 109) * d);
    float inv = 1.0 / max(d0, 1e-3);
    float sun = clamp(gasV[2] * (1.0 + wsp * 0.5 * (n - 0.5)), 0.0, 1.0);
    float amb = gasV[3], fire = gasV[4];
    vec3 dye = clamp(vec3(gasV[5], gasV[6], gasV[7]) * inv, 0.0, 1.0);
    vec3 lc = vec3(edf(h + 112), edf(h + 113), edf(h + 114));
    vec3 sh = vec3(edf(h + 115), edf(h + 116), edf(h + 117));
    vec3 mid = vec3(edf(h + 47), edf(h + 48), edf(h + 49));
    vec3 lit = dye * (lc * sun + sh * amb + mid * fire * edf(h + 118));
    vec4 c = vec4(lit * al, al);
    if (heat > 1e-4) {
        float ht = 1.0 - exp(-heat * edf(h + 53));
        float edge = edf(h + 57);
        if (edge > 0.0) {
            float k = edge * (1.0 - n) * 0.6;
            ht = clamp((ht - k) / (1.0 - k), 0.0, 1.0);
        }
        vec3 fc = flameRamp(h, ht);
        float af = smoothstep(0.02, 0.3, ht);
        float ac = af * 0.7; // light: it adds its glow and only partly hides what is behind it
        c = vec4(fc * af + c.rgb * (1.0 - ac), ac + c.a * (1.0 - ac));
    }
    // 3D: at its own depth here (as effects.gasPixel): hidden where the scene is nearer, and its
    // depth for the camera and the depth of field
    gGasZ = -1.0;
    if (ed[h + 95] != 0u) {
        float z = gasV[13];
        c *= occlAt(h, pp, z);
        if (c.a >= 0.01) gGasZ = z;
    }
    return c;
}

// The procedural clouds (as effects.cloudPixel): their params at ed[h+123]-1 (CloudParams.Pack)
// 3D gradient noise (as effects.cgrad)
float cg3(int i, int j, int k, uint seed, vec3 d) {
    uint h = pcg(uint(i) * 1597334677u ^ uint(j) * 3812015801u ^ uint(k) * 2798796415u ^ seed);
    return (float(h & 1023u) / 511.5 - 1.0) * d.x + (float((h >> 10u) & 1023u) / 511.5 - 1.0) * d.y + (float((h >> 20u) & 1023u) / 511.5 - 1.0) * d.z;
}
float cgradPlane(ivec3 i, int k, vec3 u, float dz, vec2 s, uint seed) {
    float a = cg3(i.x, i.y, k, seed, vec3(u.x, u.y, dz)), b = cg3(i.x + 1, i.y, k, seed, vec3(u.x - 1.0, u.y, dz));
    float c = cg3(i.x, i.y + 1, k, seed, vec3(u.x, u.y - 1.0, dz)), d = cg3(i.x + 1, i.y + 1, k, seed, vec3(u.x - 1.0, u.y - 1.0, dz));
    return mix(mix(a, b, s.x), mix(c, d, s.x), s.y);
}
float cgrad(vec3 p, uint seed) {
    vec3 fl = floor(p);
    ivec3 i = ivec3(fl);
    vec3 u = p - fl;
    vec3 s = u * u * u * (u * (u * 6.0 - 15.0) + 10.0);
    return 0.5 + mix(cgradPlane(i, i.z, u, u.z, s.xy, seed), cgradPlane(i, i.z + 1, u, u.z - 1.0, s.xy, seed), s.z) * 1.2;
}
float cfbm(vec2 p, float z, uint seed, int oct) {
    float v = 0.0, w = 0.0, a = 0.5;
    for (int k = 0; k < oct; k++) {
        p = vec2(0.8 * p.x - 0.6 * p.y, 0.6 * p.x + 0.8 * p.y);
        v += a * cgrad(vec3(p, z), seed + uint(k) * 17u);
        w += a;
        p = vec2(2.0 * p.x + 3.1, 2.0 * p.y + 7.3);
        z = 1.3 * z + 1.9;
        a *= 0.5;
    }
    return v / w;
}
// how much cloud at q (as effects.CloudParams.density)
float cloudDensity(int o, vec2 q, float T, float far, bool fine, uint seed) {
    vec2 c = (q + vec2(edf(o + 5), edf(o + 6)) * T) / edf(o + 2);
    float te = T * edf(o + 7);
    float wx = cfbm(vec2(c.x + 1.7, c.y + 9.2), te * 0.7, seed + 40u, 2);
    float wy = cfbm(vec2(c.x + 8.3, c.y + 2.8), te * 0.7, seed + 50u, 2);
    c += edf(o + 4) * 0.3 * (vec2(wx, wy) - 0.5);
    float t = 1.0 - edf(o);
    if (!fine) {
        float n = 0.5 + (cfbm(c, te, seed, 3) - 0.5) * 2.0;
        return smoothstep(t - 0.15, t + 0.4, n);
    }
    float n = 0.5 + (cfbm(c, te, seed, 4) - 0.5) * 2.0;
    float det = edf(o + 3) * (1.0 - far);
    if (det > 0.0) n += det * 0.35 * (cfbm(vec2(6.1 * c.x + 2.9, 6.1 * c.y + 7.7), 2.0 * te, seed + 90u, 2) - 0.5);
    float es = edf(o + 26);
    float edge = smoothstep(t - 0.03 - 0.25 * es, t + 0.1 + 0.2 * far + 0.35 * es, n);
    float thick = clamp((n - t) / max(0.25, 1.1 - t), 0.0, 1.0);
    return edge * (0.35 + 0.65 * thick);
}
// the scene's depth at p on its grid (the occlusion's: ed[h+99]-1)
float sceneDepthAt(int h, vec2 p) {
    uint og = ed[h + 99];
    if (og == 0u) return 1.0;
    int gw = int(ed[h + 100]), gh = int(ed[h + 101]);
    float d = float(ed[h + 102]);
    vec2 q = clamp(p / d - 0.5, vec2(0.0), vec2(float(gw - 1), float(gh - 1)));
    ivec2 i = max(min(ivec2(q), ivec2(gw - 2, gh - 2)), ivec2(0));
    vec2 f = q - vec2(i);
    int b = int(og) - 1;
    float a00 = edf(b + i.y * gw + i.x), a10 = edf(b + i.y * gw + min(i.x + 1, gw - 1));
    float a01 = edf(b + min(i.y + 1, gh - 1) * gw + i.x), a11 = edf(b + min(i.y + 1, gh - 1) * gw + min(i.x + 1, gw - 1));
    return mix(mix(a00, a10, f.x), mix(a01, a11, f.x), f.y);
}
vec4 cloudPixel(int h, vec2 pp, uint seed, float T) {
    int o = int(ed[h + 123]) - 1;
    if (o < 0) return vec4(0.0);
    float W_ = edf(o + 24), H_ = edf(o + 25);
    vec2 q = pp;
    float fade = 1.0, far = 0.0;
    if (edf(o + 11) > 0.5) {
        // on a ceiling going away to the horizon
        float dy = edf(o + 12) - pp.y;
        if (dy <= 0.0) return vec4(0.0);
        float z = H_ / dy;
        q = vec2((pp.x - W_ / 2.0) * z * 0.5, H_ * z * 0.5);
        fade = smoothstep(0.0, 0.1 * H_, dy);
        far = smoothstep(2.0, 6.0, z);
    }
    float top = edf(o + 8), bot = edf(o + 9), soft = edf(o + 10);
    if (top < bot) fade *= smoothstep(top - soft, top + soft, pp.y) * (1.0 - smoothstep(bot - soft, bot + soft, pp.y));
    float d = cloudDensity(o, q, T, far, true, seed);
    d = (d + (edf(o) * 0.55 - d) * far) * fade;
    if (d <= 0.001) return vec4(0.0);
    float sum = 0.0;
    vec2 L = vec2(edf(o + 13), edf(o + 14));
    for (int k = 1; k <= 3; k++) sum += cloudDensity(o, q + L * (float(k) * edf(o + 2) * 0.12), T, far, false, seed);
    float sun = exp(-edf(o + 15) * (sum * 0.4 + d * 0.6));
    float a = 1.0 - exp(-edf(o + 1) * d * 4.0);
    if (edf(o + 22) > 0.0 && ed[h + 99] != 0u) a *= 1.0 - exp(-edf(o + 22) * (1.0 - sceneDepthAt(h, pp)) * 3.0);
    vec3 lc = vec3(edf(o + 16), edf(o + 17), edf(o + 18)), sh = vec3(edf(o + 19), edf(o + 20), edf(o + 21));
    vec3 col = sh + (lc - sh) * sun + lc * (1.0 - d) * sun * 0.2 + edf(o + 23) * (0.2 + 0.7 * d) * lc;
    return vec4(min(col, vec3(1.5)) * a, a);
}

// The procedural ocean (as effects.oceanPixel): its params at ed[h+123]-1 (OceanParams.Pack);
// its reflection through gLens
vec4 oceanPixel(int h, vec2 pp, uint seed, float T) {
    int o = int(ed[h + 123]) - 1;
    if (o < 0) return vec4(0.0);
    float hor = edf(o), W_ = edf(o + 1), H_ = edf(o + 2);
    float dy = pp.y - hor;
    if (dy <= 0.0) return vec4(0.0);
    float z = H_ / dy;
    float wx = (pp.x - W_ / 2.0) * z * 0.5, wz = H_ * z * 0.5;
    float size = edf(o + 3), height = edf(o + 4), chop = edf(o + 5), speed = edf(o + 6), spread = edf(o + 7);
    float G = edf(o + 10);
    float ht = 0.0, hx = 0.0, hz = 0.0, asum = 0.0;
    vec2 q = vec2(wx, wz);
    float L = size;
    float baseA = atan(edf(o + 8), edf(o + 9));
    for (int i = 0; i < 12; i++) {
        float fade = smoothstep(1.0, 4.0, 2.0 * L / (z * z));
        if (fade > 0.0) {
            float ang = baseA + spread * (hash2(i, 0, seed) * 2.0 - 1.0);
            vec2 d = vec2(sin(ang), cos(ang));
            float k = 6.28318530718 / L;
            float w = sqrt(G * k) * speed;
            float ph = k * dot(d, q) - w * T + hash2(i, 1, seed) * 6.28318530718;
            float e = exp(chop * (sin(ph) - 1.0));
            float A = height * L * 0.012 * fade;
            ht += A * e;
            float sl = A * chop * cos(ph) * e * k;
            hx += sl * d.x;
            hz += sl * d.y;
            asum += A;
            q -= d * (sl * L * 0.05);
        }
        L *= 0.72;
    }
    float hn = asum > 0.0 ? ht / asum : 0.0;
    vec3 n = normalize(vec3(-hx, 1.0, -hz));
    vec3 v = normalize(vec3(-wx, H_ * 0.5, -wz));
    float ndv = max(0.0, dot(n, v));
    vec3 r = -v + 2.0 * ndv * n;
    r.y = max(r.y, 0.005);
    r.z = max(r.z, 0.05);
    vec2 s = vec2(W_ / 2.0 + H_ * r.x / r.z, hor - H_ * r.y / r.z);
    float F = 0.02 + 0.98 * pow(1.0 - ndv, 5.0);
    float R = min(1.0, F * edf(o + 27)) * smoothstep(-0.1 * H_, 0.0, s.y);
    vec3 u = normalize(vec3(edf(o + 17) - W_ / 2.0, hor - edf(o + 18), H_));
    float rd = max(0.0, dot(r, u) / length(r));
    float spec = (pow(rd, 600.0) * 6.0 + pow(rd, 150.0) * 0.15) * edf(o + 22) * (0.3 + F);
    float ndl = max(0.0, dot(n, u));
    float sss = max(0.0, hn - 0.15) * max(0.0, hn - 0.15) * 1.2;
    float foam = 0.0, fa = edf(o + 23);
    if (fa > 0.0) {
        float f = cfbm(vec2(wx, wz) / (size * 0.08), T * 0.4, seed + 7u, 3);
        float fl = 0.62 - 0.3 * fa;
        foam = min(1.0, fa * 3.0) * smoothstep(fl, fl + 0.25, hn + 0.3 * (f - 0.5)) * smoothstep(0.4, 0.65, f) *
            smoothstep(2.0, 8.0, 2.0 * size * 0.3 / (z * z));
    }
    vec3 deep = vec3(edf(o + 11), edf(o + 12), edf(o + 13)), shal = vec3(edf(o + 14), edf(o + 15), edf(o + 16));
    vec3 sc = vec3(edf(o + 19), edf(o + 20), edf(o + 21)), fc = vec3(edf(o + 24), edf(o + 25), edf(o + 26));
    vec3 wcol = deep * (0.55 + 0.45 * ndl) + shal * sss;
    vec3 col = (wcol * (1.0 - R) + spec * sc) * (1.0 - foam) + fc * foam;
    float a = (1.0 - R) * (1.0 - foam) + foam;
    float hf = smoothstep(0.0, edf(o + 28), dy);
    gLens = (s - pp) * hf;
    return vec4(col, a) * hf;
}

void resolveOne(uint id) {
    int n = W * H;
    int e = int(id) / n, p = int(id) - e * n;
    e += E0;
    int h = eh(e);
    ivec4 v1 = edi4(h + 4);
    int dv = int(ed[h + 42]);
    int GW = (W + dv - 1) / dv, GH = (H + dv - 1) / dv;
    uint base = accBase(e);
    int x = p % W, y = p / W;
    vec2 pp = vec2(float(x) + 0.5, float(y) + 0.5);
    uint seed = ed[h + 40];
    float T = edf(h + 41);
    vec4 c = vec4(0.0);
    gLens = vec2(0.0);
    if (ed[h + 43] == 1u) {
        // the flame: its heat taken a little aside by rising noise, its edges eaten by more noise
        // the whirls are twice as tall as wide: long tongues
        float sc = max(edf(h + 55), 1.0);
        float sy = sc * 2.0;
        float tt = T * edf(h + 56) / sy;
        float nx = fbm(vec2(pp.x / sc, pp.y / sy + tt), seed);
        float ny = fbm(vec2(pp.x / sc + 7.3, pp.y / sy + tt + 3.1), seed);
        float nz = edf(h + 54);
        vec4 s = sumAt(base, GW, GH, dv, vec2(pp.x + nz * (nx - 0.5) * 2.0, pp.y + nz * (ny - 0.5) * 2.0));
        float ht = 1.0 - exp(-s.a * edf(h + 53));
        float edge = edf(h + 57);
        if (edge > 0.0) {
            float k = edge * fbm(vec2(pp.x / (sc * 0.5), pp.y / sc + tt * 1.7), seed + 11u) * 0.6;
            ht = clamp((ht - k) / (1.0 - k), 0.0, 1.0);
        }
        vec3 cool = vec3(edf(h + 44), edf(h + 45), edf(h + 46));
        vec3 mid = vec3(edf(h + 47), edf(h + 48), edf(h + 49));
        vec3 hot = vec3(edf(h + 50), edf(h + 51), edf(h + 52));
        vec3 fc;
        if (ht < 0.35) fc = cool;
        else if (ht < 0.7) fc = cool + (mid - cool) * ((ht - 0.35) / 0.35);
        else fc = mid + (hot - mid) * ((ht - 0.7) / 0.3);
        float al = smoothstep(0.02, 0.3, ht);
        c = vec4(fc * al, al);
    } else if (ed[h + 43] == 2u) {
        // smoke: soft matter taken aside by rising noise and torn into wisps by finer noise
        float sc = max(edf(h + 77), 1.0);
        float tt = T * edf(h + 78) / sc;
        float nx = fbm(vec2(pp.x / sc, pp.y / sc + tt), seed + 17u);
        float ny = fbm(vec2(pp.x / sc + 4.1, pp.y / sc + tt + 8.7), seed + 17u);
        float wp = edf(h + 79);
        vec4 s = sumAt(base, GW, GH, dv, vec2(pp.x + wp * (nx - 0.5) * 2.0, pp.y + wp * (ny - 0.5) * 2.0));
        if (s.a > 0.0) {
            float al = 1.0 - exp(-s.a);
            float m = fbm(vec2(pp.x / (sc * 0.5), pp.y / (sc * 0.5) + tt * 1.3), seed + 23u);
            al *= 1.0 - edf(h + 76) * (1.0 - smoothstep(0.35, 0.75, m));
            c = vec4(s.rgb / s.a * al, al);
        }
    } else if (ed[h + 43] == 3u) {
        c = waterPixel(h, base, GW, GH, dv, pp, T, seed);
    } else if (ed[h + 43] == 5u) {
        c = cloudPixel(h, pp, seed, T);
    } else if (ed[h + 43] == 6u) {
        c = oceanPixel(h, pp, seed, T);
    } else if (ed[h + 43] == 4u) {
        c = gasPixel(h, pp, seed, T);
    } else {
        vec4 s = dv == 1 ? cellSum(base, GW, GH, x, y) : sumAt(base, GW, GH, dv, pp);
        if ((v1.w & 1) != 0) {
            if (s.a > 0.0) {
                float al = 1.0 - exp(-s.a);
                c = vec4(s.rgb / s.a * al, al);
            }
        } else {
            float al = min(1.0, max(s.a, max(s.r, max(s.g, s.b))));
            c = vec4(min(s.rgb, vec3(al)), al);
        }
    }
    if (ed[h + 85] != 0u) { c = vec4(0.0); gLens = vec2(0.0); } // a light source: only its glow shows
    float gI = edf(h + 58);
    if (gI > 0.0) {
        vec4 g = sumAt(glowBase(e), LW, LH, GDIV, pp);
        vec3 gc;
        if (ed[h + 63] == 1u) gc = vec3(edf(h + 60), edf(h + 61), edf(h + 62)) * g.a;
        else if (ed[h + 43] == 1u) gc = vec3(edf(h + 47), edf(h + 48), edf(h + 49)) * g.a;
        else gc = g.rgb;
        // added like light, softly saturating
        vec3 v = 1.0 - exp(-gc * gI);
        c.rgb = 1.0 - (1.0 - c.rgb) * (1.0 - v);
        c.a = max(c.a, max(c.r, max(c.g, c.b)));
    }
    lay[v1.y + p] = packUnorm4x8(clamp(c, 0.0, 1.0));
    bool lensOn = (ed[h + 43] == 3u && edf(h + 94) > 0.0) || (ed[h + 43] == 4u && edf(h + 121) > 0.0) ||
        (ed[h + 43] == 6u && ed[h + 123] != 0u && edf(int(ed[h + 123]) - 1 + 27) > 0.0);
    if (lensOn) lay[v1.y + n + p] = packHalf2x16(gLens); // its lens, after its image
    if (ed[h + 95] != 0u) {
        // its particles' depth here (weighted as their alpha, in this pixel's cell; -1 without any),
        // after its image (and lens), as effects.zPlaneAt: how the 2.5D camera moves them and the
        // depth of field blurs them (what hides them is worked out per particle: occlAt)
        int cx = min(x / dv, GW - 1), cy = min(y / dv, GH - 1);
        uint ca = acc[base + uint(cy * GW + cx) * 4u + 3u];
        float zv = ca == 0u ? -1.0 : float(acc[zBase(e) + uint(cy * GW + cx)]) / float(ca);
        if (ed[h + 43] == 4u) zv = gGasZ; // (the gas look: its own depth here)
        lay[v1.y + n * (lensOn ? 2 : 1) + p] = floatBitsToUint(zv);
    }
}
// The light at each light cell from all the sources (as effects.lightFrom)
float lightFalloff(float d, float R, float E) {
    float k = d / R;
    return 1.0 / (1.0 + 4.0 * k * k) * (1.0 - smoothstep(0.6 * E, E, d));
}
void lightPhase() {
    uint n = uint(XW * XH * (E1 - E0));
    for (uint id = gl_GlobalInvocationID.x; id < n; id += THREADS) {
        int e = int(id) / (XW * XH), c = int(id) - e * XW * XH;
        e += E0;
        int h = eh(e);
        if (ed[h + 64] == 0u) continue;
        float R = max(edf(h + 65), 1.0), E = max(edf(h + 66), 1.0);
        int x = c % XW, y = c / XW;
        uint sb = srcBase(e);
        float raw = 0.0;
        for (int k = 0; k < XW * XH; k++) {
            uint gl = ed[h + 43] == 4u ? ed[h + 119] : 0u; // the gas look: its flames' sources
            uint v = gl > 0u ? lay[gl - 1u + uint(k)] : ed[h + 43] == 4u ? 0u : acc[sb + uint(k)];
            if (v == 0u) continue;
            float dx = float(k % XW - x) * float(XDIV), dy = float(k / XW - y) * float(XDIV);
            raw += float(v) / FIXED * lightFalloff(sqrt(dx * dx + dy * dy), R, E);
        }
        acc[fieldBase(e) + uint(c)] = floatBitsToUint(1.0 - exp(-raw * (1.0 / 40.0)));
    }
}

void resolvePhase() {
    uint n = uint(W * H * (E1 - E0));
    for (uint k = gl_GlobalInvocationID.x; k < n; k += THREADS) resolveOne(k);
}

// one invocation per particle of the batch (their numbers run on from emitter to emitter)
void splatPhase() {
    int p0 = int(ed[eh(E0)]);
    ivec4 v = edi4(eh(E1 - 1));
    int p1 = v.x + v.z;
    for (int j = p0 + int(gl_GlobalInvocationID.x); j < p1; j += int(THREADS)) splatOne(j);
}

void main() {
    NE = int(ed[0]);
    W = int(ed[1]);
    H = int(ed[2]);
    LW = (W + GDIV - 1) / GDIV;
    LH = (H + GDIV - 1) / GDIV;
    XW = (W + XDIV - 1) / XDIV;
    XH = (H + XDIV - 1) / XDIV;
    E0 = pc.e0;
    E1 = min(E0 + pc.n, NE);
    if (E0 >= E1) return;
    if (pc.phase == 0) clearPhase();
    else if (pc.phase == 1) splatPhase();
    else if (pc.phase == 2) resolvePhase();
    else lightPhase();
}
