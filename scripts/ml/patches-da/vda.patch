+bool Engine::is_video() const { return ml_.tensor("head.tm.0.norm.weight") != nullptr; }
+bool Engine::depth_video(const std::vector<Image>& frames, std::vector<float>& depth_out, int& H, int& W){
+    std::vector<std::vector<std::vector<float>>> feats(frames.size());
+    std::vector<std::pair<uint64_t, std::vector<std::vector<float>>>> next;
+    H = W = 0;
+    for (size_t i = 0; i < frames.size(); ++i) {
+        uint64_t hsh = 1469598103934665603ull ^ (uint64_t)frames[i].w * 31 ^ (uint64_t)frames[i].h;
+        for (unsigned char b : frames[i].rgb) hsh = (hsh ^ b) * 1099511628211ull;
+        Preprocessed p;
+        if (!preprocess_real(frames[i], ml_.config(), p)) { DA_LOG("depth_video: preprocess failed"); return false; }
+        if (i > 0 && (p.H != H || p.W != W)) { DA_LOG("depth_video: frames of different sizes"); return false; }
+        H = p.H; W = p.W;
+        bool found = false;
+        for (auto& c : video_feats_) {
+            if (c.first == hsh && !c.second.empty()) { feats[i] = c.second; found = true; break; }
+        }
+        if (!found) {
+            DinoBackbone bb(ml_, be_);
+            std::vector<std::vector<float>> cam_tokens;
+            if (!bb.forward(p.chw, H, W, feats[i], cam_tokens)) { DA_LOG("depth_video: backbone failed"); return false; }
+        }
+        next.emplace_back(hsh, feats[i]);
+    }
+    video_feats_ = std::move(next);
+    DptHead head(ml_, be_);
+    return head.depth_video(feats, H, W, depth_out);
+}
