 void da_capi_free_floats(float* p){ std::free(p); }
+float* da_capi_depth_video(da_ctx* c, const unsigned char* rgb, int n, int w, int h, int* out_h, int* out_w){
+    if (!c || !c->engine || !rgb || n < 1 || w < 1 || h < 1){ if (c) c->last_error = "depth_video: bad args"; return nullptr; }
+    if (!c->engine->is_video()){ c->last_error = "depth_video: not a video depth model"; return nullptr; }
+    std::vector<da::Image> frames(n);
+    const size_t fs = (size_t)w * h * 3;
+    for (int i = 0; i < n; ++i) {
+        frames[i].w = w; frames[i].h = h;
+        frames[i].rgb.assign(rgb + fs * i, rgb + fs * (i + 1));
+    }
+    std::vector<float> depth; int H = 0, W = 0;
+    if (!c->engine->depth_video(frames, depth, H, W)){ c->last_error = "depth_video: failed"; return nullptr; }
+    float* p = (float*)std::malloc(depth.size() * sizeof(float));
+    if (!p){ c->last_error = "depth_video: oom"; return nullptr; }
+    std::memcpy(p, depth.data(), depth.size() * sizeof(float));
+    if (out_h) *out_h = H;
+    if (out_w) *out_w = W;
+    return p;
+}
