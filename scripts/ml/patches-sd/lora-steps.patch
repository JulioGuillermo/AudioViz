+// audioviz: the strength of the LoRAs applied at runtime on each sampling step (scales[i] for step
+// i + 1, the last one for the rest; n = 0: as given)
+void sd_set_lora_step_scales(const float* scales, int n) {
+    auto& v = av_lora_step_scales();
+    v.assign(scales, scales + (n > 0 ? n : 0));
+}
