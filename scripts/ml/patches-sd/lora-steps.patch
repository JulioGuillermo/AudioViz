 #define LORA_GRAPH_BASE_SIZE 10240
 
+// audioviz: a LoRA's strength per sampling step (sd_set_lora_step_scales), e.g. NitroFusion2's
+// de-distillation LoRA at 0.5 on the first step only. The diffusion graph is built again every
+// step, so the LoRAs applied at runtime follow it (1 when none is set)
+inline std::vector<float>& av_lora_step_scales() {
+    static std::vector<float> v;
+    return v;
+}
+inline int& av_lora_step() {
+    static int s = 0;
+    return s;
+}
+inline float av_lora_step_scale() {
+    auto& v = av_lora_step_scales();
+    if (v.empty()) {
+        return 1.f;
+    }
+    size_t i = (size_t)std::max(0, av_lora_step() - 1);
+    return v[std::min(i, v.size() - 1)];
+}
