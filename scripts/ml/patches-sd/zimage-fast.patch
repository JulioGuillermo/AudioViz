+    // Positions instead of a rotation table: an I32 tensor [L, n_axes] (each axis' integer
+    // positions, contiguous), its theta and axes' dims in the op params of the tensor it views
+    // (op_params[0] = theta, [1] = n_axes, [2..] = the dims). With it, the rotation is ggml's own
+    // (one kernel per axis on its part of the head), instead of permutes, repeats and products.
+    __STATIC_INLINE__ ggml_tensor* positions_input(ggml_context* ctx, const std::vector<std::vector<float>>& ids,
+                                                   int theta, const std::vector<int>& axes_dim,
+                                                   std::vector<int32_t>& data) {
+        int64_t L = static_cast<int64_t>(ids.size());
+        int n_axes = static_cast<int>(axes_dim.size());
+        data.assign(L * n_axes, 0);
+        for (int64_t i = 0; i < L; i++) {
+            for (int a = 0; a < n_axes; a++) {
+                float p = ids[i][a];
+                if (p != std::floor(p)) {
+                    return nullptr;  // (a position between tokens: the table then)
+                }
+                data[a * L + i] = static_cast<int32_t>(p);
+            }
+        }
+        auto pos = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, L, n_axes);
+        pos->op_params[0] = theta;
+        pos->op_params[1] = n_axes;
+        for (int a = 0; a < n_axes && a < 12; a++) {
+            pos->op_params[2 + a] = axes_dim[a];
+        }
+        return pos;
+    }
+
+    // positions_slice: the positions of tokens [start, end)
+    __STATIC_INLINE__ ggml_tensor* positions_slice(ggml_context* ctx, ggml_tensor* pos, int64_t start, int64_t end) {
+        return ggml_view_2d(ctx, pos, end - start, pos->ne[1], pos->nb[1], start * pos->nb[0]);
+    }
+
+    // rope_positions: x [N, L, n_head, d_head] (ggml: d_head, n_head, L, N) rotated, interleaved
+    // pairs, each axis on its own part of the head (as embed_nd's table does)
+    __STATIC_INLINE__ ggml_tensor* rope_positions(ggml_context* ctx, ggml_tensor* x, ggml_tensor* pos) {
+        const ggml_tensor* src = pos->view_src ? pos->view_src : pos;
+        const int theta  = src->op_params[0];
+        const int n_axes = src->op_params[1];
+        int offs = 0;
+        for (int a = 0; a < n_axes; a++) {
+            const int dim = src->op_params[2 + a];
+            auto p = ggml_view_1d(ctx, pos, pos->ne[0], a * pos->nb[1]);
+            x = ggml_rope_ext(ctx, x, p, nullptr, dim, GGML_ROPE_TYPE_NORMAL, 0, static_cast<float>(theta), 1.f, 0.f, 1.f, 0.f, 0.f);
+            ggml_rope_set_offset(x, offs);
+            offs += dim;
+        }
+        return x;
+    }
