+#pragma once
+// Fusions for diffusion transformers (dit-fuse.cpp)
+#include "common.hpp"
+
+// At node i (a SCALE or RMS_NORM): [SCALE] RMS_NORM MUL(w) ... MUL(g) [ADD(r)] as one kernel (the
+// nodes in between, independent of the chain, computed first with compute). Returns how many nodes
+// after i it consumed (0: no match, nothing done; -1: an in-between node failed).
+int ggml_sycl_dit_norm_chain(ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int i,
+                             bool (*compute)(ggml_backend_sycl_context &, ggml_tensor *));
+
+// CONT -> SCALE -> (permute) -> CPY f16 at node i (a CONT); SCALE -> SCALE (a SCALE); SWIGLU ->
+// SCALE (a GLU). Each returns the nodes consumed after i (0: no match, nothing done).
+int ggml_sycl_dit_cont_scale_cast(ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int i);
+int ggml_sycl_dit_scale_scale(ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int i);
+int ggml_sycl_dit_swiglu_scale(ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int i);
+
+// IM2COL -> MUL_MAT at node i (an IM2COL) as a oneDNN convolution: nodes consumed after i (0: no
+// match or oneDNN refused it, nothing done)
+int ggml_sycl_im2col_conv(ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int i);
diff --git a/src/ggml-sycl/sd-ext.cpp b/src/ggml-sycl/sd-ext.cpp
new file mode 100644
index 0000000..4aec7f6
--- /dev/null
+++ b/src/ggml-sycl/sd-ext.cpp
@@ -0,0 +1,485 @@
+// stable-diffusion.cpp's custom operators (ggml-ext) on SYCL: without them the SYCL backend runs the
+// generic graphs instead (RoPE through a table: REPEAT + MUL + ADD + CONT, plus a permute and a cast
+// to f16 before the attention). stable-diffusion.cpp hands the operators over through the registry's
+// "ggml_ext_sycl_register_v1" (scripts/ml/patches-sd/sycl-ext.patch); GGML_SYCL_SD_EXT=0 turns
+// them off (to compare).
+//
+//   sd.rope_apply.v1: x [D, heads, tokens, N] rotated by pe [2, 2, D/2', tokens] into a contiguous
+//   [D, tokens, heads * N] (the attention's layout). Fused, as on Vulkan and the CPU: RMS_NORM +
+//   MUL(weight) + rope (+ SCALE) (+ CPY to f16): the q/k norm, the rotation, the attention scale and
+//   the cast in one pass over the row.
+
+#include "common.hpp"
+#include "ggml-backend-impl.h"
+#include "ggml-ext.h"
+
+#include <cstring>
+
+namespace {
+
+ggml_ext_op_t g_rope_op = nullptr;
+
+bool aligned4(const ggml_tensor * t) {
+    for (int i = 0; i < GGML_MAX_DIMS; i++) {
+        if (t->nb[i] % sizeof(float)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// rope_infer of stable-diffusion.cpp (src/core/ggml_extensions.cpp), plus a contiguous f32 output
+bool rope_ok(const ggml_tensor * node) {
+    if (!node || !g_rope_op || ggml_ext_op_get(node) != g_rope_op || node->type != GGML_TYPE_F32 || !ggml_is_contiguous(node)) {
+        return false;
+    }
+    const ggml_tensor * x  = node->src[0];
+    const ggml_tensor * pe = node->src[1];
+    return x && pe && x->type == GGML_TYPE_F32 && pe->type == GGML_TYPE_F32 && x->ne[0] % 2 == 0 && pe->ne[0] == 2 &&
+           pe->ne[1] == 2 && pe->ne[2] > 0 && pe->ne[2] <= x->ne[0] / 2 && pe->ne[3] == x->ne[2] && node->ne[0] == x->ne[0] &&
+           node->ne[1] == x->ne[2] && node->ne[2] == x->ne[1] * x->ne[3] && node->ne[3] == 1 && aligned4(x) && aligned4(pe);
+}
+
+bool rope_supports(ggml_backend_dev_t, const ggml_tensor * node, void *) {
+    return rope_ok(node);
+}
+
+float fparam(const ggml_tensor * t, int i) {
+    float v;
+    std::memcpy(&v, t->op_params + i, sizeof v);
+    return v;
+}
+
+// [RMS_NORM, MUL(weight), rope] (+ SCALE without bias) (+ CPY to a contiguous f16 of the same shape)
+int rope_match(ggml_backend_dev_t, const ggml_cgraph * graph, int first, void *) {
+    auto *    g = const_cast<ggml_cgraph *>(graph);
+    const int n = ggml_graph_n_nodes(g);
+    if (first + 2 >= n) {
+        return 0;
+    }
+    const ggml_tensor * norm = ggml_graph_node(g, first);
+    const ggml_tensor * mul  = ggml_graph_node(g, first + 1);
+    const ggml_tensor * rope = ggml_graph_node(g, first + 2);
+    if (norm->op != GGML_OP_RMS_NORM || norm->type != GGML_TYPE_F32 || !norm->src[0] || norm->src[0]->type != GGML_TYPE_F32 ||
+        !aligned4(norm->src[0]) || mul->op != GGML_OP_MUL || mul->type != GGML_TYPE_F32 || !ggml_are_same_shape(norm, mul) ||
+        rope->src[0] != mul || !rope_ok(rope)) {
+        return 0;
+    }
+    const ggml_tensor * w = mul->src[0] == norm ? mul->src[1] : (mul->src[1] == norm ? mul->src[0] : nullptr);
+    if (!w || w->type != GGML_TYPE_F32 || w->ne[0] != norm->ne[0] || ggml_nelements(w) != w->ne[0] || !aligned4(w)) {
+        return 0;
+    }
+    int count = 3;
+    const ggml_tensor * last = rope;
+    if (first + count < n) {
+        const ggml_tensor * s = ggml_graph_node(g, first + count);
+        if (s->op == GGML_OP_SCALE && s->src[0] == rope && s->type == GGML_TYPE_F32 && fparam(s, 1) == 0.0f &&
+            first + count + 1 < n) {
+            const ggml_tensor * c = ggml_graph_node(g, first + count + 1);
+            if (c->op == GGML_OP_CPY && c->src[0] == s && c->type == GGML_TYPE_F16 && ggml_is_contiguous(c) &&
+                ggml_are_same_shape(rope, c)) {
+                return 5;
+            }
+        }
+        if (s->op == GGML_OP_CPY && s->src[0] == last && s->type == GGML_TYPE_F16 && ggml_is_contiguous(s) &&
+            ggml_are_same_shape(rope, s)) {
+            return 4;
+        }
+    }
+    return count;
+}
+
+struct RopeArgs {
+    const char * x;
+    int64_t      xnb0, xnb1, xnb2, xnb3;
+    const char * pe;
+    int64_t      penb0, penb1, penb2, penb3;
+    const char * w;     // norm weight (nullptr: no norm)
+    int64_t      wnb0;
+    float        eps;
+    float        scale;  // output scale
+    int64_t      D, H, T, rows, half;
+    bool         interleaved;
+};
+
+template <typename T, int WG>
+void rope_kernel(const RopeArgs a, T * out, const sycl::nd_item<1> & it) {
+    const int64_t r   = it.get_group(0);
+    const int     lid = it.get_local_id(0);
+    const int64_t tok = r % a.T;
+    const int64_t hd  = (r / a.T) % a.H;
+    const int64_t bt  = r / (a.T * a.H);
+    const char *  in  = a.x + hd * a.xnb1 + tok * a.xnb2 + bt * a.xnb3;
+    const char *  pos = a.pe + tok * a.penb3;
+    T *           o   = out + r * a.D;
+    auto          xv  = [&](int64_t c) { return *reinterpret_cast<const float *>(in + c * a.xnb0); };
+    float         rms = 1.0f;
+    if (a.w) {
+        float s = 0.0f;
+        for (int64_t c = lid; c < a.D; c += WG) {
+            const float v = xv(c);
+            s += v * v;
+        }
+        s   = sycl::reduce_over_group(it.get_group(), s, sycl::plus<float>());
+        rms = sycl::rsqrt(s / a.D + a.eps);
+    }
+    auto val = [&](int64_t c) {
+        float v = xv(c);
+        if (a.w) {
+            v = v * rms * *reinterpret_cast<const float *>(a.w + c * a.wnb0);
+        }
+        return v;
+    };
+    for (int64_t j = lid; j < a.half; j += WG) {
+        const int64_t i0 = a.interleaved ? 2 * j : j;
+        const int64_t i1 = a.interleaved ? 2 * j + 1 : j + a.half;
+        const float   p  = val(i0);
+        const float   q  = val(i1);
+        const char *  m  = pos + j * a.penb2;
+        const float   c  = *reinterpret_cast<const float *>(m);
+        const float   s  = *reinterpret_cast<const float *>(m + a.penb1);
+        float         o0, o1;
+        if (a.interleaved) {
+            const float ns = *reinterpret_cast<const float *>(m + a.penb0);
+            const float c1 = *reinterpret_cast<const float *>(m + a.penb0 + a.penb1);
+            o0             = p * c + q * ns;
+            o1             = p * s + q * c1;
+        } else {
+            o0 = p * c - q * s;
+            o1 = p * s + q * c;
+        }
+        o[i0] = T(o0 * a.scale);
+        o[i1] = T(o1 * a.scale);
+    }
+    for (int64_t c = 2 * a.half + lid; c < a.D; c += WG) {
+        o[c] = T(val(c) * a.scale);
+    }
+}
+
+bool overlaps(const ggml_tensor * a, const ggml_tensor * b) {
+    const char * a0 = (const char *) a->data;
+    const char * b0 = (const char *) b->data;
+    return a0 < b0 + ggml_nbytes(b) && b0 < a0 + ggml_nbytes(a);
+}
+
+ggml_status rope_execute(const ggml_ext_execution_context * ctx, ggml_tensor * const * nodes, int count, void *, void *) {
+    auto *              sctx   = static_cast<ggml_backend_sycl_context *>(ctx->backend->context);
+    const ggml_tensor * norm   = count >= 3 ? nodes[0] : nullptr;
+    const ggml_tensor * mul    = count >= 3 ? nodes[1] : nullptr;
+    const ggml_tensor * rope   = count >= 3 ? nodes[2] : nodes[0];
+    const ggml_tensor * scalen = count == 5 ? nodes[3] : nullptr;
+    ggml_tensor *       dst    = nodes[count - 1];
+    const ggml_tensor * x      = norm ? norm->src[0] : rope->src[0];
+    const ggml_tensor * pe     = rope->src[1];
+    int32_t             inter;
+    std::memcpy(&inter, ggml_ext_op_attributes(rope), sizeof inter);
+
+    RopeArgs a{};
+    a.x = (const char *) x->data;
+    a.xnb0 = x->nb[0]; a.xnb1 = x->nb[1]; a.xnb2 = x->nb[2]; a.xnb3 = x->nb[3];
+    a.pe = (const char *) pe->data;
+    a.penb0 = pe->nb[0]; a.penb1 = pe->nb[1]; a.penb2 = pe->nb[2]; a.penb3 = pe->nb[3];
+    if (norm) {
+        const ggml_tensor * w = mul->src[0] == norm ? mul->src[1] : mul->src[0];
+        a.w    = (const char *) w->data;
+        a.wnb0 = w->nb[0];
+        std::memcpy(&a.eps, norm->op_params, sizeof a.eps);
+    }
+    a.scale       = scalen ? fparam(scalen, 0) : 1.0f;
+    a.D           = x->ne[0];
+    a.H           = x->ne[1];
+    a.T           = x->ne[2];
+    a.rows        = x->ne[1] * x->ne[2] * x->ne[3];
+    a.half        = pe->ne[2];
+    a.interleaved = inter != 0;
+
+    ggml_sycl_set_device(sctx->device);
+    queue_ptr q = sctx->stream();
+    // the output may reuse the input's storage (allocator): then through a scratch buffer
+    const bool scratch = overlaps(dst, x) || overlaps(dst, pe);
+    void *     out     = scratch ? sycl::malloc_device(ggml_nbytes(dst), *q) : dst->data;
+    constexpr int WG   = 64;
+    const sycl::nd_range<1> range(sycl::range<1>(a.rows * WG), sycl::range<1>(WG));
+    if (dst->type == GGML_TYPE_F16) {
+        sycl::half * o = (sycl::half *) out;
+        q->parallel_for(range, [=](sycl::nd_item<1> it) { rope_kernel<sycl::half, WG>(a, o, it); });
+    } else {
+        float * o = (float *) out;
+        q->parallel_for(range, [=](sycl::nd_item<1> it) { rope_kernel<float, WG>(a, o, it); });
+    }
+    if (scratch) {
+        q->memcpy(dst->data, out, ggml_nbytes(dst));
+        q->wait();
+        sycl::free(out, *q);
+    }
+    return GGML_STATUS_SUCCESS;
+}
+
+}  // namespace
+
+// ---- INT8 (W8A8, "convrot"): stable-diffusion.cpp's sd.quantize_i8_convrot.v1 and sd.linear_i8.v1.
+// Activations: rotated in groups of G (scaled by 1/sqrt(G), radix-4 butterflies; G = 0: none) and
+// quantized per row (absmax / 127, round to nearest). The packed form is K int8 per row for
+// rows rounded up to 4, then one float scale per row. The product: int8 x int8 -> int32 on XMX
+// through oneDNN, then * row scale * column scale + bias.
+
+namespace {
+
+ggml_ext_op_t g_i8_op      = nullptr;
+ggml_ext_op_t g_convrot_op = nullptr;
+
+struct I8Attr {
+    int64_t shape[3];
+    int32_t group_size;
+    int32_t flags;  // 1 packed, 2 input scale, 4 weight scale, 8 bias
+};
+
+bool valid_group(int g) { return g == 1 || g == 4 || g == 16 || g == 64 || g == 256; }
+
+int64_t padded_rows(int64_t rows) { return (rows + 3) / 4 * 4; }
+
+// rotate every group of G of each row into tmp (float)
+void convrot_rotate(queue_ptr q, const float * x, float * tmp, int64_t rows, int64_t K, int G) {
+    constexpr int WG = 64;
+    const int64_t groups = rows * (K / G);
+    const float   inv    = 1.0f / sycl::sqrt(float(G));
+    q->submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> v(sycl::range<1>(256), h);
+        h.parallel_for(sycl::nd_range<1>(sycl::range<1>(groups * WG), sycl::range<1>(WG)), [=](sycl::nd_item<1> it) {
+            const int64_t gi  = it.get_group(0);
+            const int     lid = it.get_local_id(0);
+            const float * src = x + gi * G;  // rows are contiguous, K % G == 0
+            for (int i = lid; i < G; i += WG) v[i] = src[i] * inv;
+            sycl::group_barrier(it.get_group());
+            for (int stride = 1; stride < G; stride *= 4) {
+                for (int qd = lid; qd < G / 4; qd += WG) {
+                    const int   base = (qd / stride) * 4 * stride, j = qd % stride, i = base + j;
+                    const float a = v[i], b = v[i + stride], c = v[i + 2 * stride], d = v[i + 3 * stride];
+                    v[i]              = a + b + c - d;
+                    v[i + stride]     = a + b - c + d;
+                    v[i + 2 * stride] = a - b + c + d;
+                    v[i + 3 * stride] = -a + b + c + d;
+                }
+                sycl::group_barrier(it.get_group());
+            }
+            float * dst = tmp + gi * G;
+            for (int i = lid; i < G; i += WG) dst[i] = v[i];
+        });
+    });
+}
+
+// quantize each row of src (float) to int8 with its absmax / 127
+void quantize_rows(queue_ptr q, const float * src, int8_t * out, float * scales, int64_t rows, int64_t K) {
+    constexpr int WG = 256;
+    q->parallel_for(sycl::nd_range<1>(sycl::range<1>(rows * WG), sycl::range<1>(WG)), [=](sycl::nd_item<1> it) {
+        const int64_t r   = it.get_group(0);
+        const int     lid = it.get_local_id(0);
+        const float * s   = src + r * K;
+        float         m   = 0.0f;
+        for (int64_t c = lid; c < K; c += WG) m = sycl::fmax(m, sycl::fabs(s[c]));
+        m                 = sycl::reduce_over_group(it.get_group(), m, sycl::maximum<float>());
+        const float scale = m / 127.0f;
+        const float inv   = scale == 0.0f ? 0.0f : 1.0f / scale;
+        if (lid == 0) scales[r] = scale;
+        int8_t * o = out + r * K;
+        for (int64_t c = lid; c < K; c += WG) {
+            o[c] = (int8_t) sycl::clamp(sycl::rint(s[c] * inv), -127.0f, 127.0f);
+        }
+    });
+}
+
+// f32 rows -> int8 rows + scales (with the convrot rotation if G > 0)
+void quantize_input(ggml_backend_sycl_context & ctx, queue_ptr q, const float * x, int64_t rows, int64_t K, int G,
+                    int8_t * out, float * scales) {
+    if (G > 1) {
+        ggml_sycl_pool_alloc<float> tmp(ctx.pool(), rows * K);
+        convrot_rotate(q, x, tmp.get(), rows, K, G);
+        quantize_rows(q, tmp.get(), out, scales, rows, K);
+    } else {
+        quantize_rows(q, x, out, scales, rows, K);
+    }
+}
+
+bool convrot_supports(ggml_backend_dev_t, const ggml_tensor * node, void *) {
+    if (!g_convrot_op || ggml_ext_op_get(node) != g_convrot_op || node->type != GGML_TYPE_I8 || !ggml_is_contiguous(node)) {
+        return false;
+    }
+    const ggml_tensor * x = node->src[0];
+    int32_t             G;
+    std::memcpy(&G, ggml_ext_op_attributes(node), sizeof G);
+    if (!x || x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || !valid_group(G) || x->ne[0] % G) return false;
+    const int64_t rows = ggml_nrows(x), K = x->ne[0];
+    return node->ne[0] == K && node->ne[1] == padded_rows(rows) + (rows * 4 - 1) / K + 1;
+}
+
+ggml_status convrot_execute(const ggml_ext_execution_context * c, ggml_tensor * const * nodes, int, void *, void *) {
+    auto *              ctx = static_cast<ggml_backend_sycl_context *>(c->backend->context);
+    ggml_tensor *       dst = nodes[0];
+    const ggml_tensor * x   = dst->src[0];
+    int32_t             G;
+    std::memcpy(&G, ggml_ext_op_attributes(dst), sizeof G);
+    const int64_t rows = ggml_nrows(x), K = x->ne[0];
+    ggml_sycl_set_device(ctx->device);
+    queue_ptr q = ctx->stream();
+    int8_t *  out    = (int8_t *) dst->data;
+    float *   scales = (float *) (out + padded_rows(rows) * K);
+    quantize_input(*ctx, q, (const float *) x->data, rows, K, G, out, scales);
+    if (padded_rows(rows) > rows) q->memset(out + rows * K, 0, (padded_rows(rows) - rows) * K);
+    return GGML_STATUS_SUCCESS;
+}
+
+struct I8Parts {
+    const ggml_tensor *w, *x, *xs, *ws, *b;
+    I8Attr             a;
+};
+
+bool i8_parts(const ggml_tensor * node, I8Parts * p) {
+    if (!g_i8_op || ggml_ext_op_get(node) != g_i8_op || node->type != GGML_TYPE_F32 || !ggml_is_contiguous(node)) return false;
+    std::memcpy(&p->a, ggml_ext_op_attributes(node), sizeof p->a);
+    if (p->a.flags & ~15) return false;
+    p->w = node->src[0];
+    p->x = node->src[1];
+    p->xs = p->ws = p->b = nullptr;
+    int i = 2;
+    if (p->a.flags & 2) p->xs = node->src[i++];
+    if (p->a.flags & 4) p->ws = node->src[i++];
+    if (p->a.flags & 8) p->b = node->src[i++];
+    const ggml_tensor * w = p->w;
+    if (!w || !p->x || w->type != GGML_TYPE_I8 || !ggml_is_contiguous(w) || w->ne[2] != 1 || w->ne[3] != 1 ||
+        node->ne[0] != w->ne[1] || !ggml_is_contiguous(p->x)) {
+        return false;
+    }
+    for (const ggml_tensor * t : { p->xs, p->ws, p->b }) {
+        if (t && (t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t))) return false;
+    }
+    const bool packed = p->a.flags & 1;
+    if (packed) return p->x->type == GGML_TYPE_I8 && !p->xs && p->x->ne[0] == w->ne[0];
+    if (p->x->type == GGML_TYPE_I8) return p->xs && p->a.group_size == 0;
+    return p->x->type == GGML_TYPE_F32 && !p->xs && p->x->ne[0] == w->ne[0] &&
+           (p->a.group_size == 0 || (valid_group(p->a.group_size) && w->ne[0] % p->a.group_size == 0));
+}
+
+bool i8_supports(ggml_backend_dev_t, const ggml_tensor * node, void *) {
+    I8Parts p;
+    return i8_parts(node, &p);
+}
+
+ggml_status i8_execute(const ggml_ext_execution_context * c, ggml_tensor * const * nodes, int, void *, void *) {
+    auto *        ctx = static_cast<ggml_backend_sycl_context *>(c->backend->context);
+    ggml_tensor * dst = nodes[0];
+    I8Parts       p;
+    if (!i8_parts(dst, &p)) return GGML_STATUS_FAILED;
+    const int64_t K = p.w->ne[0], N = p.w->ne[1], rows = dst->ne[1] * dst->ne[2] * dst->ne[3];
+    ggml_sycl_set_device(ctx->device);
+    queue_ptr q = ctx->stream();
+
+    // the int8 rows and their scales
+    const int8_t *                 xq;
+    const float *                  xs;
+    ggml_sycl_pool_alloc<int8_t>   qbuf(ctx->pool());
+    ggml_sycl_pool_alloc<float>    sbuf(ctx->pool());
+    if (p.a.flags & 1) {
+        xq = (const int8_t *) p.x->data;
+        xs = (const float *) (xq + padded_rows(rows) * K);
+    } else if (p.x->type == GGML_TYPE_I8) {
+        xq = (const int8_t *) p.x->data;
+        xs = (const float *) p.xs->data;
+    } else {
+        int8_t * qo = qbuf.alloc(rows * K);
+        float *  so = sbuf.alloc(rows);
+        quantize_input(*ctx, q, (const float *) p.x->data, rows, K, p.a.group_size, qo, so);
+        xq = qo;
+        xs = so;
+    }
+
+    // int32 = int8 rows [rows, K] x int8 weights^T [K, N] (oneDNN, XMX)
+    ggml_sycl_pool_alloc<int32_t> acc(ctx->pool(), rows * N);
+    {
+        using dt   = dnnl::memory::data_type;
+        auto eng   = ctx->engine_dnnl(q);
+        auto strm  = ctx->stream_dnnl(q);
+        auto a_md  = dnnl::memory::desc({ rows, K }, dt::s8, { K, 1 });
+        auto b_md  = dnnl::memory::desc({ K, N }, dt::s8, { 1, K });
+        auto c_md  = dnnl::memory::desc({ rows, N }, dt::s32, { N, 1 });
+        dnnl::primitive_attr attr;
+        attr.set_scratchpad_mode(dnnl::scratchpad_mode::user);
+        auto pd = dnnl::matmul::primitive_desc(eng, a_md, b_md, c_md, attr);
+        ggml_sycl_pool_alloc<uint8_t> scratch(ctx->pool());
+        void * sp = pd.scratchpad_desc().get_size() > 0 ? scratch.alloc(pd.scratchpad_desc().get_size()) : nullptr;
+        dnnl::matmul(pd).execute(strm, { { DNNL_ARG_SRC, dnnl::memory(a_md, eng, const_cast<int8_t *>(xq)) },
+                                         { DNNL_ARG_WEIGHTS, dnnl::memory(b_md, eng, p.w->data) },
+                                         { DNNL_ARG_DST, dnnl::memory(pd.dst_desc(), eng, acc.get()) },
+                                         { DNNL_ARG_SCRATCHPAD, dnnl::memory(pd.scratchpad_desc(), eng, sp) } });
+    }
+
+    // * row scale * column scale + bias
+    const int32_t * A  = acc.get();
+    const float *   ws = p.ws ? (const float *) p.ws->data : nullptr;
+    const float *   bb = p.b ? (const float *) p.b->data : nullptr;
+    float *         o  = (float *) dst->data;
+    constexpr int   WG = 256;
+    q->parallel_for(sycl::nd_range<1>(sycl::range<1>(rows * WG), sycl::range<1>(WG)), [=](sycl::nd_item<1> it) {
+        const int64_t r   = it.get_group(0);
+        const int     lid = it.get_local_id(0);
+        const float   rs  = xs[r];
+        for (int64_t n = lid; n < N; n += WG) {
+            float v = float(A[r * N + n]) * rs;
+            if (ws) v *= ws[n];
+            if (bb) v += bb[n];
+            o[r * N + n] = v;
+        }
+    });
+    return GGML_STATUS_SUCCESS;
+}
+
+}  // namespace
+
+// stable-diffusion.cpp's operators, in its order: [0] sd.rope_apply.v1, [1] sd.linear_i8.v1,
+// [2] sd.quantize_i8_convrot.v1 (older stable-diffusion.cpp builds pass only the first). Registers the SYCL kernels
+// for the device (once, before graphs are allocated).
+extern "C" bool ggml_ext_sycl_register_v1(ggml_backend_dev_t device, const ggml_ext_op_t * ops, int n_ops) {
+    const char * off = getenv("GGML_SYCL_SD_EXT");
+    if ((off && off[0] == '0') || n_ops < 1 || !ops[0]) {
+        return false;
+    }
+    g_rope_op = ops[0];
+
+    ggml_ext_kernel_desc d = {};
+    d.abi_version          = GGML_EXT_ABI_VERSION;
+    d.name                 = "sd.rope_apply.sycl.v1";
+    d.op                   = GGML_OP_CUSTOM;
+    d.custom_op            = g_rope_op;
+    d.priority             = 100;
+    d.supports             = rope_supports;
+    d.execute              = rope_execute;
+    bool ok                = ggml_ext_register_kernel(device, &d);
+
+    d.name      = "sd.rms_norm_mul_rope.sycl.v1";
+    d.op        = GGML_OP_RMS_NORM;
+    d.custom_op = nullptr;
+    d.priority  = 200;
+    d.supports  = nullptr;
+    d.match     = rope_match;
+    ok          = ggml_ext_register_kernel(device, &d) && ok;
+    if (n_ops >= 3 && ops[1] && ops[2]) {
+        g_i8_op      = ops[1];
+        g_convrot_op = ops[2];
+        d            = {};
+        d.abi_version = GGML_EXT_ABI_VERSION;
+        d.name        = "sd.linear_i8.sycl.v1";
+        d.op          = GGML_OP_CUSTOM;
+        d.custom_op   = g_i8_op;
+        d.priority    = 100;
+        d.supports    = i8_supports;
+        d.execute     = i8_execute;
+        ok            = ggml_ext_register_kernel(device, &d) && ok;
+        d.name        = "sd.quantize_i8_convrot.sycl.v1";
+        d.custom_op   = g_convrot_op;
+        d.supports    = convrot_supports;
+        d.execute     = convrot_execute;
+        ok            = ggml_ext_register_kernel(device, &d) && ok;
+    }
+    GGML_LOG_INFO("ggml_ext_sycl: stable-diffusion.cpp operators on SYCL: %s\n",
+                  !ok ? "failed" : g_i8_op ? "rope, int8 (W8A8 convrot)" : "rope");
+    return ok;
+}
