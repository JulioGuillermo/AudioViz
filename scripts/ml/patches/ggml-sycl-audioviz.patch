+// GGML_SYCL_OP_PROF=1: the time of each launch (a node, or a fused group of them) after waiting for
+// the queue, added up by its ops and output shape; the table goes to stderr at exit. Fusion is kept
+// (unlike a per-node eval callback), so it shows what is really launched. Slower (one wait per launch).
+struct ggml_sycl_op_prof {
+    struct acc { double ms = 0; long n = 0; };
+    std::map<std::string, acc> tab;
+    double total = 0;
+    // the end of the last graph: the time until the next one starts is the host's (graph
+    // building, allocation, the sampler, copies between backends), counted on its own
+    std::chrono::steady_clock::time_point last_end{};
+    FILE * trace = nullptr;  // GGML_SYCL_OP_PROF=2: every launch in order (/tmp/ggml-sycl-op-trace.txt)
+    // (rewritten after every graph: a host that ends with exit_group never runs static destructors)
+    void dump() {
+        const char * path = getenv("GGML_SYCL_OP_PROF_FILE");
+        FILE * f = fopen(path && path[0] ? path : "/tmp/ggml-sycl-op-prof.txt", "w");
+        if (!f) return;
+        std::vector<std::pair<std::string, acc>> v(tab.begin(), tab.end());
+        std::sort(v.begin(), v.end(), [](auto & a, auto & b) { return a.second.ms > b.second.ms; });
+        fprintf(f, "== GGML_SYCL_OP_PROF: %.0f ms in %zu kinds\n", total, v.size());
+        for (size_t k = 0; k < v.size(); k++) {
+            fprintf(f, "%9.1f ms %5.1f%% %6ld %8.3f ms/launch  %s\n", v[k].second.ms, 100 * v[k].second.ms / total,
+                    v[k].second.n, v[k].second.ms / v[k].second.n, v[k].first.c_str());
+        }
+        fclose(f);
+    }
+};
+static ggml_sycl_op_prof * ggml_sycl_op_prof_get() {
+    static int on = -1;
+    if (on < 0) {
+        const char * e = getenv("GGML_SYCL_OP_PROF");
+        on = e && (e[0] == 0x31 || e[0] == 0x32); // "1", "2" (with the trace)
+        if (on) GGML_LOG_INFO("GGML_SYCL_OP_PROF: on (one wait per launch)\n");
+    }
+    if (!on) return nullptr;
+    static ggml_sycl_op_prof prof;
+    static bool traced = false;
+    if (!traced) {
+        traced = true;
+        const char * e = getenv("GGML_SYCL_OP_PROF");
+        if (e && e[0] == 0x32) prof.trace = fopen("/tmp/ggml-sycl-op-trace.txt", "w");
+    }
+    return &prof;
+}
+static std::string ggml_sycl_op_prof_label(ggml_cgraph * cgraph, int from, int to) {
+    std::string ops;
+    ggml_tensor * last = nullptr;
+    for (int j = from; j < to; j++) {
+        ggml_tensor * t = cgraph->nodes[j];
+        if (ggml_sycl_is_view_or_noop(t) || (t->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) continue;
+        if (!ops.empty()) ops += "+";
+        ops += t->op == GGML_OP_UNARY ? ggml_unary_op_name(ggml_get_unary_op(t)) :
+               t->op == GGML_OP_GLU ? ggml_glu_op_name(ggml_get_glu_op(t)) : ggml_op_name(t->op);
+        if (t->op == GGML_OP_MUL_MAT && t->src[0]) { ops += "("; ops += ggml_type_name(t->src[0]->type); ops += ")"; }
+        if ((t->op == GGML_OP_CPY || t->op == GGML_OP_CONT) && t->src[0]) {
+            ops += "("; ops += ggml_type_name(t->src[0]->type); ops += ggml_is_contiguous(t->src[0]) ? ">" : "~>";
+            ops += ggml_type_name(t->type); ops += ")";
+        }
+        last = t;
+    }
+    if (!last) return "";
+    char sh[96];
+    snprintf(sh, sizeof sh, " [%lld,%lld,%lld,%lld]", (long long) last->ne[0], (long long) last->ne[1],
+             (long long) last->ne[2], (long long) last->ne[3]);
+    return ops + sh;
+}
