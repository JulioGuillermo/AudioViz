/* The symbols the AudioViz binary exports (build.sh, Linux): ggml's own, for the backend plugins
   it loads at run time (scripts/build-sycl-plugin.sh), which take them from it instead of
   carrying a second ggml. Nothing else (its static C++ runtime stays private). */
{
  ggml_*;
  gguf_*;
  quantize_*;
  dequantize_*;
};
